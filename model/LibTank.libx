  <Model>
    <Type>Tank</Type>
    <Parameters>
      <Parameter>
        <Name>FluidType</Name>
        <Type>FluidType</Type>
        <Default>FuelOil</Default>
      </Parameter>
    </Parameters>
    <Conditions>
      <Condition>
        <Name>PRO</Name>
        <Expression>Mode=Process</Expression>
      </Condition>
      <Condition>
        <Name>FD</Name>
        <Expression>Mode=FluidFLow or Mode=Dynamics</Expression>
      </Condition>
      <Condition>
        <Name>C</Name>
        <Expression>False</Expression>
      </Condition>
    </Conditions>
    <Connections>
      <Connection>
        <Name>Conn1</Name>
        <Type>Parameter</Type>
        <From>Feed.FluidType</From>
        <To>State.FluidType</To>
      </Connection>
      <Connection>
        <Name>Conn2</Name>
        <Type>Parameter</Type>
        <From>State.FluidType</From>
        <To>Prod.FluidType</To>
      </Connection>
      <Connection>
        <Name>Conn3</Name>
        <Type>Parameter</Type>
        <From>Feed.FluidType</From>
        <To>FluidType</To>
      </Connection>
    </Connections>
    <Variables>
      <Variable>
        <Name>P</Name>
        <Type>Pressure</Type>
        <FluidFlowMode />
        <DynamicMode />
      </Variable>
      <Variable>
        <Name>L</Name>
        <Type>Length</Type>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
      </Variable>
      <Variable>
        <Name>D</Name>
        <Type>Diameter</Type>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
      </Variable>
      <Variable>
        <Name>V</Name>
        <Type>Volume</Type>
      </Variable>
      <Variable>
        <Name>tau</Name>
        <Type>Time</Type>
      </Variable>
      <Variable>
        <Name>MT</Name>
        <Type>Moles</Type>
      </Variable>
      <Variable>
        <Name>Level</Name>
        <Type>Fraction</Type>
        <ProcessMode />
      </Variable>
      <Variable>
        <Name>M</Name>
        <Type>Moles</Type>
        <Dimension>FluidType.CompList</Dimension>
      </Variable>
      <Variable>
        <Name>E</Name>
        <Type>Energy</Type>
      </Variable>
      <Variable>
        <Name>dEdt</Name>
        <Type>Real</Type>
        <Default>0</Default>
      </Variable>
      <Variable>
        <Name>dMdt</Name>
        <Type>Real</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Default>0</Default>
      </Variable>
    </Variables>
    <Equations>
      <Equation>
        <Name>Eqn1</Name>
        <Formula>State.P=Feed.P</Formula>
      </Equation>
      <Equation>
        <Name>Eqn2</Name>
        <Formula>State.H=Feed.H</Formula>
      </Equation>
      <Equation>
        <Name>Eqn3</Name>
        <Formula>State.z=Feed.z</Formula>
      </Equation>
      <Equation>
        <Name>Eqn4</Name>
        <Formula>P=State.P</Formula>
      </Equation>
      <Equation>
        <Name>Eqn5</Name>
        <Formula>Feed.zr=tear(Feed.z)</Formula>
      </Equation>
      <Equation>
        <Name>Eqn6</Name>
        <Formula>Feed.Hr=tear(Feed.H)</Formula>
      </Equation>
      <Equation>
        <Name>Eqn7</Name>
        <Formula>V=3.14159/4 * D^2 * L</Formula>
      </Equation>
      <Equation>
        <Name>Eqn8</Name>
        <Formula>MT=Feed.F * tau</Formula>
      </Equation>
      <Equation>
        <Name>Eqn9</Name>
        <Formula>MT * State.MW=State.rho * V * Level</Formula>
      </Equation>
      <Equation>
        <Name>Eqn10</Name>
        <Condition>PRO</Condition>
        <Formula>Prod.F = Feed.F</Formula>
      </Equation>
      <Equation>
        <Name>Eqn11</Name>
        <Condition>PRO</Condition>
        <Formula>Prod.H = State.H</Formula>
      </Equation>
      <Equation>
        <Name>Eqn12</Name>
        <Condition>PRO</Condition>
        <Formula>Prod.z = State.z</Formula>
      </Equation>
      <Equation>
        <Name>Eqn13</Name>
        <Formula>Prod.P = P + State.rho * 9.81 / 1000 * Level * L</Formula>
      </Equation>
      <Equation>
        <Name>Eqn14</Name>
        <Condition>FD</Condition>
        <Formula>der(E) = Feed.F*Feed.H - Prod.F*Prod.H</Formula>
      </Equation>
      <Equation>
        <Name>Eqn15</Name>
        <Condition>FD</Condition>
        <Formula>der(M) = Feed.F*Feed.Z - Prod.F*Prod.Z</Formula>
      </Equation>
      <Equation>
        <Name>Eqn16</Name>
        <Condition>FD</Condition>
        <Formula>sum(Prod.z) = 1</Formula>
      </Equation>
      <Equation>
        <Name>Eqn17</Name>
        <Condition>FD</Condition>
        <Formula>E = State.H * MT</Formula>
      </Equation>
      <Equation>
        <Name>Eqn18</Name>
        <Condition>FD</Condition>
        <Formula>M = State.z * MT</Formula>
      </Equation>
      <Equation>
        <Name>Eqn19</Name>
        <Formula>Level_Fraction.value = Level</Formula>
      </Equation>
    </Equations>
    <Models>
      <Model>
        <Name>State</Name>
        <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
      </Model>
    </Models>
    <Ports>
      <Port>
        <Name>Feed</Name>
        <Library Version="8.2.0">Submodels</Library>
        <Type>FlowPort</Type>
      </Port>
      <Port>
        <Name>Prod</Name>
        <Direction>Out</Direction>
        <Library Version="8.2.0">Submodels</Library>
        <Type>FlowPort</Type>
      </Port>
      <Port>
        <Name>Level_Fraction</Name>
        <Direction>Out</Direction>
        <Library Version="8.2.0">Submodels</Library>
        <Type>TransPort</Type>
      </Port>
    </Ports>
