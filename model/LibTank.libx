        <From>Phases</From>
        <To>InState.PhaseOverride</To>
      </Connection>
      <Connection>
        <Name>PHASEOVR1b</Name>
        <Condition>PhaseOvrrdeNo</Condition>
        <Type>Parameter</Type>
        <From>PhaseNoOverride</From>
        <To>InState.PhaseOverride</To>
      </Connection>
      <Connection>
        <Name>PHASEOVR2a</Name>
        <Condition>PhaseOvrrde</Condition>
        <Type>Parameter</Type>
        <From>Phases</From>
        <To>OutState.PhaseOverride</To>
      </Connection>
      <Connection>
        <Name>PHASEOVR2b</Name>
        <Condition>PhaseOvrrdeNo</Condition>
        <Type>Parameter</Type>
        <From>PhaseNoOverride</From>
        <To>OutState.PhaseOverride</To>
      </Connection>
      <Connection>
        <Name>In2a</Name>
        <Condition>DoubleState</Condition>
        <Type>Variable</Type>
        <From>In.H</From>
        <To>InState.H</To>
      </Connection>
      <Connection>
        <Name>In2b</Name>
        <Condition>DoubleState</Condition>
        <Type>Variable</Type>
        <From>In.z</From>
        <To>InState.z</To>
      </Connection>
      <Connection>
        <Name>Out2a</Name>
        <Condition>DoubleState</Condition>
        <Type>Variable</Type>
        <From>Out.Hr</From>
        <To>OutState.H</To>
      </Connection>
      <Connection>
        <Name>Out2b</Name>
        <Condition>DoubleState</Condition>
        <Type>Variable</Type>
        <From>Out.zr</From>
        <To>OutState.z</To>
      </Connection>
      <Connection>
        <Name>Conn12</Name>
        <Condition>DoubleSNFR</Condition>
        <Type>Parameter</Type>
        <From>CheckValve</From>
        <To>FlowCalcR.Check</To>
      </Connection>
      <Connection>
        <Name>Conn13</Name>
        <Condition>DoubleState</Condition>
        <Type>Parameter</Type>
        <From>Leak</From>
        <To>FlowCalcR.Leak</To>
      </Connection>
      <Connection>
        <Name>DPlin1</Name>
        <Type>Parameter</Type>
        <From>DPlin</From>
        <To>FlowCalc.dplin</To>
      </Connection>
      <Connection>
        <Name>DPlin2</Name>
        <Condition>DoubleState</Condition>
        <Type>Parameter</Type>
        <From>DPlin</From>
        <To>FlowCalcR.dplin</To>
      </Connection>
    </Connections>
    <Variables>
      <Variable>
        <Name>W</Name>
        <Description>Valve mass flow</Description>
        <Type>Mass Flow</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>Q</Name>
        <Description>Valve inlet actual volumetric flow</Description>
        <Type>Vol Flow</Type>
        <Group>Operation</Group>
        <Min>-1000000</Min>
      </Variable>
      <Variable>
        <Name>F</Name>
        <Description>Valve molar / standard volume flow</Description>
        <Type>Mole Flow</Type>
        <Group>Operation</Group>
        <Min>-1000000</Min>
      </Variable>
      <Variable>
        <Name>DP</Name>
        <Description>Valve pressure difference</Description>
        <Condition>LSNO</Condition>
        <Type>Diff Pressure</Type>
        <Group>Operation</Group>
        <ProcessMode />
        <Required />
        <Favorite />
      </Variable>
      <Variable>
        <Name>DP</Name>
        <Description>Valve pressure difference from line size type</Description>
        <Condition>LSCV</Condition>
        <Type>Diff Pressure</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>P1</Name>
        <Description>Valve inlet pressure</Description>
        <Type>Pressure</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>FluidType.PMin</Min>
        <Max>FluidType.PMax</Max>
      </Variable>
      <Variable>
        <Name>P2</Name>
        <Description>Valve outlet pressure</Description>
        <Type>Pressure</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>FluidType.PMin</Min>
        <Max>FluidType.PMax</Max>
      </Variable>
      <Variable>
        <Name>Cv</Name>
        <Description>Valve flow coefficient</Description>
        <Condition>LSNFR</Condition>
        <Type>Flow Coefficient</Type>
        <Group>Valve Data</Group>
        <FluidFlowMode />
        <DynamicMode />
        <Required />
        <Favorite />
        <Invariant />
      </Variable>
      <Variable>
        <Name>Cv</Name>
        <Description>Valve flow coefficient from line size type</Description>
        <Condition>LSCV</Condition>
        <Type>Flow Coefficient</Type>
        <Group>Valve Data</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Favorite />
        <Invariant />
      </Variable>
      <Variable>
        <Name>Wmax</Name>
        <Description>Valve flow range maximum</Description>
        <Condition>FR</Condition>
        <Type>Mass Flow</Type>
        <Group>Valve Data</Group>
        <FluidFlowMode />
        <DynamicMode />
        <Required />
        <Favorite />
        <Invariant />
        <Default>6</Default>
      </Variable>
      <Variable>
        <Name>Wmin</Name>
        <Description>Valve flow range minimum</Description>
        <Condition>FR</Condition>
        <Type>Mass Flow</Type>
        <Group>Valve Data</Group>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
        <Favorite />
        <Invariant />
        <Default>0</Default>
      </Variable>
      <Variable>
        <Name>ManPos</Name>
        <Description>Valve manual position</Description>
        <Condition>Man</Condition>
        <Type>Signal</Type>
        <Group>Operation</Group>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
        <Favorite />
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>Pos</Name>
        <Description>Valve actuator position</Description>
        <Type>Signal</Type>
        <Group>Operation</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Favorite />
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>El</Name>
        <Description>Valve elevation</Description>
        <Condition>Elev</Condition>
        <Type>Elevation</Type>
        <Group>Elevation</Group>
        <Favorite />
        <Min>-1000</Min>
        <Max>1000</Max>
      </Variable>
      <Variable>
        <Name>FailPos</Name>
        <Description>Valve resting position when failed</Description>
        <Type>Fraction</Type>
        <Default>0</Default>
      </Variable>
      <Variable>
        <Name>Fail</Name>
        <Description>Valve fail status.</Description>
        <Type>Fraction</Type>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>Trip</Name>
        <Description>Valve trip value.\n     set 0 to trip the valve\n     set 1 to reset the trip</Description>
        <Type>Signal</Type>
        <Group>Actuator </Group>
        <ProcessMode Lock="Always">true</ProcessMode>
        <FluidFlowMode Lock="Always">true</FluidFlowMode>
        <DynamicMode Lock="Always">true</DynamicMode>
        <Favorite />
      </Variable>
      <Variable>
        <Name>dplinchk</Name>
        <Description>Valve check absolute DP - dplin</Description>
        <Condition>NFR</Condition>
        <Type>Diff Pressure</Type>
      </Variable>
      <Variable>
        <Name>D</Name>
        <Description>Valve pipe diameter</Description>
        <Condition>StdNotNone</Condition>
        <Type>Pipe Diameter</Type>
        <Group>Pipe Data</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Favorite />
        <Invariant />
        <Min>0</Min>
      </Variable>
      <Variable>
        <Name>D</Name>
        <Description>Valve pipe diameter</Description>
        <Condition>StdNone</Condition>
        <Type>Pipe Diameter</Type>
        <Group>Pipe Data</Group>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
        <Required />
        <Favorite />
        <Invariant />
        <Min>0</Min>
      </Variable>
    </Variables>
    <Equations>
      <Equation>
        <Name>D1</Name>
        <Description>Valve pipe diameter</Description>
        <Condition>StdNotNone</Condition>
        <Formula>D = Std.D</Formula>
      </Equation>
      <Equation>
        <Name>DP1</Name>
        <Description>Valve pressure difference</Description>
        <Formula>P2 = P1 - DP</Formula>
      </Equation>
      <Equation>
        <Name>W1a</Name>
        <Description>Valve mass flow</Description>
        <Condition>SingleState</Condition>
        <Formula>W = In.F * InState.MW</Formula>
      </Equation>
      <Equation>
        <Name>W1b</Name>
        <Description>Valve mass flow</Description>
        <Condition>DoubleState</Condition>
        <Formula>W = max(F, 0) * InState.MW + min(F, 0) * OutState.MW</Formula>
      </Equation>
      <Equation>
        <Name>W2</Name>
        <Description>Valve mass flow forward and reverse flow selection</Description>
        <Condition>DoubleSNFR</Condition>
        <Formula>W = FlowCalc.W + FlowCalcR.W</Formula>
      </Equation>
      <Equation>
        <Name>Q1</Name>
        <Description>Valve actual volumetric flow</Description>
        <Condition>SingleState</Condition>
        <Formula>Q = In.F * InState.V</Formula>
      </Equation>
      <Equation>
        <Name>Q2</Name>
        <Description>Valve actual volumetric flow</Description>
        <Condition>DoubleState</Condition>
        <Formula>Q = max(F, 0) * InState.V + min(F, 0) * OutState.V</Formula>
      </Equation>
      <Equation>
        <Name>POS1</Name>
        <Description>Valve automatic control input in steady state</Description>
        <Condition>AutoSS</Condition>
        <Formula>Control.Value = Actuator.In</Formula>
      </Equation>
      <Equation>
        <Name>POS1A</Name>
        <Description>Valve automatic control input in dynamics</Description>
        <Condition>AutoDyn</Condition>
        <Formula>Fail * Control.Value  + (1 - Fail) * FailPos = Actuator.In</Formula>
      </Equation>
      <Equation>
        <Name>POS2</Name>
        <Description>Valve manual input</Description>
        <Condition>ManSS</Condition>
        <Formula>ManPos = Actuator.In</Formula>
      </Equation>
      <Equation>
        <Name>POS3</Name>
        <Description>Valve set port control value when not connected in steady state</Description>
        <Condition>ManSS</Condition>
        <Formula>ManPos = Control.Value</Formula>
      </Equation>
      <Equation>
        <Name>POS2A</Name>
        <Description>Valve manual input in dynamics</Description>
        <Condition>ManDyn</Condition>
        <Formula>Fail * ManPos + (1 - Fail) * FailPos = Actuator.In</Formula>
      </Equation>
      <Equation>
        <Name>POS3A</Name>
        <Description>Valve set port control value when not connected in dynamics</Description>
        <Condition>ManDyn</Condition>
        <Formula>Fail * ManPos + (1 - Fail) * FailPos = Control.Value</Formula>
      </Equation>
      <Equation>
        <Name>FC1</Name>
        <Description>Valve reverse flow maximum inlet or outlet pressure</Description>
        <Condition>Comp</Condition>
        <Formula>FlowCalc.P = InState.P</Formula>
      </Equation>
      <Equation>
        <Name>FC2</Name>
        <Description>Valve set xT parameter to flow submodel variable</Description>
        <Condition>Comp</Condition>
        <Formula>FlowCalc.xT = xT</Formula>
      </Equation>
      <Equation>
        <Name>FC3</Name>
        <Description>Valve set CpCv parameter to flow submodel variable</Description>
        <Condition>Comp</Condition>
        <Formula>FlowCalc.CpCv = CpCv</Formula>
      </Equation>
      <Equation>
        <Name>FC4</Name>
        <Description>Valve set flow calculation fraction open</Description>
        <Condition>NFR</Condition>
        <Formula>FlowCalc.A = Character.A</Formula>
      </Equation>
      <Equation>
        <Name>FC5</Name>
        <Description>Valve reverse flow inlet density selection</Description>
        <Condition>NFR</Condition>
        <Formula>FlowCalc.rho = InState.rho</Formula>
      </Equation>
      <Equation>
        <Name>FC6</Name>
        <Description>Valve Cv takes absolute value for reverse flow</Description>
        <Condition>NFR</Condition>
        <Formula>Cv = FlowCalc.Cv</Formula>
      </Equation>
      <Equation>
        <Name>RF1</Name>
        <Description>Valve loop back reverse enthalpy</Description>
        <Condition>LB</Condition>
        <Formula>Out.Hr = tear(Out.H)</Formula>
      </Equation>
      <Equation>
        <Name>RF2</Name>
        <Description>Valve reverse flow composition</Description>
        <Condition>LB</Condition>
        <Formula>Out.zr = tear(Out.z)</Formula>
      </Equation>
      <Equation>
        <Name>RF3</Name>
        <Description>Valve reverse flow enthalpy selection</Description>
        <Condition>SingleState</Condition>
        <Formula>InState.H = select(tear(In.F), In.H, Out.Hr, FRramp)</Formula>
      </Equation>
      <Equation>
        <Name>RF4</Name>
        <Description>Valve reverse flow composition selection</Description>
        <Condition>SingleState</Condition>
        <Formula>InState.z = select(tear(In.F), In.z, Out.zr, FRramp)</Formula>
      </Equation>
      <Equation>
        <Name>RF5a</Name>
        <Description>Valve reverse flow upstream pressure selection</Description>
        <Condition>SingleState</Condition>
        <Formula>InState.P = max(P1, P2)</Formula>
      </Equation>
      <Equation>
        <Name>RF6a</Name>
        <Description>Valve reverse flow downstream pressure selection</Description>
        <Condition>SingleState</Condition>
        <Formula>OutState.P = min(P2, P1)</Formula>
      </Equation>
      <Equation>
        <Name>RF5b</Name>
        <Description>Valve reverse flow upstream pressure selection</Description>
        <Condition>DoubleState</Condition>
        <Formula>InState.P = P1</Formula>
      </Equation>
      <Equation>
        <Name>RF6b</Name>
        <Description>Valve reverse flow downstream pressure selection</Description>
        <Condition>DoubleState</Condition>
        <Formula>OutState.P = P2</Formula>
      </Equation>
      <Equation>
        <Name>Eqn1</Name>
        <Description>Valve flow range</Description>
        <Condition>FR</Condition>
        <Formula>W = Wmin + Character.A * (Wmax - Wmin)</Formula>
      </Equation>
      <Equation>
        <Name>Eqn2</Name>
        <Description>Valve does not set outlet pressure</Description>
        <Formula>Out.setp = 0</Formula>
      </Equation>
      <Equation>
        <Name>FP1</Name>
        <Description>Valve fail status</Description>
        <Formula>Fail = Trip * Motive.MP</Formula>
      </Equation>
      <Equation>
        <Name>FP2</Name>
        <Description>Valve desired position when fail position set to closed</Description>
        <Condition>FC</Condition>
        <Formula>FailPos = 0</Formula>
      </Equation>
      <Equation>
        <Name>FP3</Name>
        <Description>Valve desired position when fail position set to open</Description>
        <Condition>FO</Condition>
        <Formula>FailPos = 1</Formula>
      </Equation>
      <Equation>
        <Name>FP4</Name>
        <Description>Valve desired position when fail position set to last</Description>
        <Condition>FL</Condition>
        <Formula>FailPos = tear(pos)</Formula>
      </Equation>
      <Equation>
        <Name>DPcheck</Name>
        <Description>Valve check absolute DP - dplin</Description>
        <Condition>NFR</Condition>
        <Formula>dplinchk = abs(DP) - FlowCalc.dplin</Formula>
      </Equation>
      <Equation>
        <Name>RC1</Name>
        <Description>Valve reverse flow maximum inlet pressure selection</Description>
        <Condition>DoubleSComp</Condition>
        <Formula>FlowCalcR.P = P2</Formula>
      </Equation>
      <Equation>
        <Name>RC2</Name>
        <Description>Valve set reverse xT parameter to flow submodel variable</Description>
        <Condition>DoubleSComp</Condition>
        <Formula>FlowCalcR.xT = xT</Formula>
      </Equation>
      <Equation>
        <Name>RC3</Name>
        <Description>Valve set reverse CpCv parameter to flow submodel variable</Description>
        <Condition>DoubleSComp</Condition>
        <Formula>FlowCalcR.CpCv = CpCv</Formula>
      </Equation>
      <Equation>
        <Name>RC4</Name>
        <Description>Valve set reverse flow calculation fraction open</Description>
        <Condition>DoubleSNFR</Condition>
        <Formula>FlowCalcR.A = Character.A</Formula>
      </Equation>
      <Equation>
        <Name>RC5</Name>
        <Description>Valve reverse flow inlet density</Description>
        <Condition>DoubleSNFR</Condition>
        <Formula>FlowCalcR.rho = OutState.rho</Formula>
      </Equation>
      <Equation>
        <Name>RC6</Name>
        <Description>Valve Cv for reverse flow</Description>
        <Condition>DoubleSNFR</Condition>
        <Formula>Cv = FlowCalcR.Cv</Formula>
      </Equation>
      <Equation>
        <Name>FlowDP1</Name>
        <Description>Valve forward flow FlowCalcR DP</Description>
        <Condition>DoubleSNFR</Condition>
        <Formula>FlowCalc.DP = max(0, In.P - Out.P)</Formula>
      </Equation>
      <Equation>
        <Name>FlowDP2</Name>
        <Description>Valve reverse flow FlowCalcR DP</Description>
        <Condition>DoubleSNFR</Condition>
        <Formula>FlowCalcR.DP = min(0, In.P - Out.P)</Formula>
      </Equation>
    </Equations>
    <Models>
      <Model>
        <Name>InState</Name>
        <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
      </Model>
      <Model>
        <Name>OutState</Name>
        <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
      </Model>
      <Model>
        <Name>FlowCalc</Name>
        <Condition>Incomp</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>ValveFlowI</Type>
      </Model>
      <Model>
        <Name>FlowCalc</Name>
        <Condition>Comp</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>ValveFlowC</Type>
      </Model>
      <Model>
        <Name>Actuator</Name>
        <Library Version="8.2.0">Submodels</Library>
        <Type>Lag</Type>
      </Model>
      <Model>
        <Name>Character</Name>
        <Library Version="8.2.0">Submodels</Library>
        <Type>ValveChar</Type>
      </Model>
      <Model>
        <Name>ValveSize</Name>
        <Condition>LSCV</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>ValveCoeff</Type>
      </Model>
      <Model>
        <Name>Motive</Name>
        <ModelTypeParameter>MotiveModelType</ModelTypeParameter>
      </Model>
      <Model>
        <Name>FlowCalcR</Name>
        <Condition>DoubleSIncomp</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>ValveFlowI</Type>
      </Model>
      <Model>
        <Name>FlowCalcR</Name>
        <Condition>DoubleSComp</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>ValveFlowC</Type>
      </Model>
      <Model>
        <Name>Std</Name>
        <Condition>StdNPS</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>NPSTable</Type>
      </Model>
      <Model>
        <Name>Std</Name>
        <Condition>StdDN</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>DNTable</Type>
      </Model>
      <Model>
        <Name>Std</Name>
        <Condition>StdJISA</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>JISATable</Type>
      </Model>
      <Model>
        <Name>Std</Name>
        <Condition>StdJISB</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>JISBTable</Type>
      </Model>
      <Model>
        <Name>Std</Name>
        <Condition>StdGOST</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>GOSTTable</Type>
      </Model>
      <Model>
        <Name>Std</Name>
        <Condition>StdDIN</Condition>
        <Library Version="8.2.0">Submodels</Library>
        <Type>DINTable</Type>
      </Model>
    </Models>
    <Ports>
      <Port>
        <Name>In</Name>
        <Library Version="8.2.0">Submodels</Library>
        <Type>FlowPort</Type>
      </Port>
      <Port>
        <Name>Out</Name>
        <Direction>Out</Direction>
        <Library Version="8.2.0">Submodels</Library>
        <Type>FlowPort</Type>
      </Port>
      <Port>
        <Name>Control</Name>
        <Library Version="8.2.0">Submodels</Library>
        <Type>ControlPort</Type>
      </Port>
    </Ports>
    <Groups>
      <Group>
        <Name>Configuration</Name>
      </Group>
      <Group>
        <Name>Valve Data</Name>
      </Group>
      <Group>
        <Name>Actuator </Name>
        <Description>Valve failure settings</Description>
      </Group>
      <Group>
        <Name>Operation</Name>
        <IsExpandedByDefault>true</IsExpandedByDefault>
      </Group>
      <Group>
        <Name>Pipe Data</Name>
        <Description>Line Sized Valve</Description>
      </Group>
      <Group>
        <Name>Elevation</Name>
        <Description>Elevation variables for hydraulic calculations. To view and edit elevations, set Elevations = Manual or Automatic.</Description>
      </Group>
    </Groups>
    <Messages>
      <Message>
        <Name>DPTooLarge</Name>
        <Condition>Pro</Condition>
        <Expression>DP &gt; P1</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Pressure drop is larger than inlet pressure. Decrease pressure drop or increase inlet pressure.</DisplayMessage>
      </Message>
      <Message>
        <Name>ZeroFlow</Name>
        <Condition>MC</Condition>
        <Expression>W &lt; 1E-6 and LineSizedCv = Actual and Cv.Calculated</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Cannot calculate Cv at zero or negative flow. Specify Cv at its actual value and calculate ManPos, or use LineSizedCv.</DisplayMessage>
      </Message>
      <Message>
        <Name>ModeCheck1</Name>
        <Condition>MC</Condition>
        <Expression>Out.NumberOfConnections = 0</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Valve outlet must be connected for Fluid Flow and Dynamics modes.</DisplayMessage>
      </Message>
      <Message>
        <Name>ValveTooLarge</Name>
        <Condition>MC</Condition>
        <Expression>Cv &gt; 100000</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Valve is probably too large. Check value of Cv.</DisplayMessage>
      </Message>
      <Message>
        <Name>SmallDP</Name>
        <Condition>NFR</Condition>
        <Expression>dplinchk &lt; 1E-6 and Mode = Process</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>DP is less than dplin. Check DP, dplin or calculated valve Cv.</DisplayMessage>
      </Message>
      <Message>
        <Name>UseSeparateStates</Name>
        <Condition>NFR</Condition>
        <Expression>RFState = Single</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Valve RFState is set to 'Single' which will be removed in future releases. Set RFState = Double to avoid rapid changes to the flash during flow reversal.</DisplayMessage>
      </Message>
      <Message>
        <Name>DiaTooSmall</Name>
        <Expression>D &lt; 0.001</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Improper input data. Valve pipe diameter too small.</DisplayMessage>
      </Message>
    </Messages>
    <GraphicData>
      <Icon>
        <DefaultIcon>Man</DefaultIcon>
        <Images>
          <Image>
            <Name>Auto</Name>
            <Condition>Auto</Condition>
            <Rendering>
              <Drawing Format="xaml">&lt;Viewbox
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="http://software.schneider-electric.com/simsci/simcentral/1.0"
    Stretch="Fill"&gt;
    &lt;Viewbox.Resources&gt;
        &lt;converter:RangeValueConverter
            x:Key="ValveRange"
            HighBound="0.99"
            LowBound="0.01" /&gt;
        &lt;RadialGradientBrush x:Key="noStyleFill" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1" RadiusY="1"&gt;
            &lt;GradientStop Offset="0.20" Color="White" /&gt;
            &lt;GradientStop Offset="1.0" Color="#ffA0A0A0" /&gt;
        &lt;/RadialGradientBrush&gt;
	&lt;LinearGradientBrush x:Key="defaultBrush" StartPoint="0.5,0.1" EndPoint="0.5,0.9"&gt;
          &lt;GradientStop Color="#ff707070" Offset="0.0" /&gt;
          &lt;GradientStop Color="White" Offset="0.5" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/LinearGradientBrush&gt;
        &lt;LinearGradientBrush x:Key="normalBrush" StartPoint="0.5,0.1" EndPoint="0.5,0.9"&gt;
            &lt;GradientStop Offset="0.0" Color="Yellow" /&gt;
            &lt;GradientStop Offset="0.5" Color="White" /&gt;
            &lt;GradientStop Offset="1.0" Color="Yellow" /&gt;
        &lt;/LinearGradientBrush&gt;
        &lt;LinearGradientBrush x:Key="redBrush" StartPoint="0.5,0.1" EndPoint="0.5,0.9"&gt;
            &lt;GradientStop Offset="0.0" Color="Red" /&gt;
            &lt;GradientStop Offset="0.5" Color="White" /&gt;
            &lt;GradientStop Offset="1.0" Color="Red" /&gt;
        &lt;/LinearGradientBrush&gt;
        &lt;LinearGradientBrush x:Key="greenBrush" StartPoint="0.5,0.1" EndPoint="0.5,0.9"&gt;
            &lt;GradientStop Offset="0.0" Color="Green" /&gt;
            &lt;GradientStop Offset="0.5" Color="White" /&gt;
            &lt;GradientStop Offset="1.0" Color="Green" /&gt;
        &lt;/LinearGradientBrush&gt;
        &lt;Geometry x:Key="ValveOutLine"&gt;M 15,34 q 0,-4 7,0 l 56,32 q 7,4 7,0 v -32 q 0,-4 -7,0 l -56,32 q -7,4 -7,0 z&lt;/Geometry&gt;
