<?xml version="1.0" encoding="utf-8"?>
<Library xmlns:info="http://SimSci.Com/NextGenSim/Schema2.0.0/Informational" xmlns="http://SimSci.Com/NextGenSim/Schema2.0.0">
  <Name>LibTank</Name>
  <info:SoftwareVersion>8.2.0.1755</info:SoftwareVersion>
  <Version>8.2.0.1755</Version>
  <Model>
    <Type>Sink</Type>
    <Description>Product boundary</Description>
    <NamePrefix>SNK</NamePrefix>
    <NameStartingNumber>1</NameStartingNumber>
    <Parameters>
      <Parameter>
        <Name>FluidType</Name>
        <Description>Sink fluid type</Description>
        <Type>FluidType</Type>
        <Group>Configuration</Group>
        <Default></Default>
      </Parameter>
      <Parameter>
        <Name>ModeCheck</Name>
        <Description>Global check for mode change warnings while still in Process mode</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Process</Default>
        <Favorite />
        <Global />
        <Values>
          <Value>Process</Value>
          <Value>AllModes</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>GlobalComponents</Name>
        <Description>Global GlobalComponents option to display component fractions or flows on molar or mass basis</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>MoleFractions</Default>
        <Favorite />
        <Global />
        <Values>
          <Value>MoleFractions</Value>
          <Value>MassFractions</Value>
          <Value>MoleRates</Value>
          <Value>MassRates</Value>
          <Value>MoleFractionRates</Value>
          <Value>MassFractionRates</Value>
          <Value>All</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Components</Name>
        <Description>Sink Components option to display component fractions or flows on molar or mass basis.\nSet Components to Global and change it globally using GlobalComponents.</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Global</Default>
        <Favorite />
        <Values>
          <Value>Global</Value>
          <Value>MoleFractions</Value>
          <Value>MassFractions</Value>
          <Value>MoleRates</Value>
          <Value>MassRates</Value>
          <Value>MoleFractionRates</Value>
          <Value>MassFractionRates</Value>
          <Value>All</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Industry</Name>
        <Description>Sink selection to calculate industry-specific property sets \n   Petro: Standard liquid density, vapor/liquid standard flow</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Hide</Default>
        <Favorite />
        <Values>
          <Value>Hide</Value>
          <Value>Petro</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Elevations</Name>
        <Description>Global selection to enable the specification of equipment port elevations.\n     Disabled: disable specifications for port elevations.  The elevation change (DE) can still be specified in the Pipe and PipeRig models.\n     Manual: manually specify port elevations. DE in the Pipe and PipeRig models can be swapped for port elevation specifications.\n     Automatic: automatically calculate port elevations using equipment geometry and configuration options for select models (Column, Drum, etc).\n\nWhen automatic elevations are enabled, an elevation specification must be removed from each inlet stream of impacted models (for example, remove the DE specification from an inlet Pipe).\nOther model elevations must still be manually specified. For an explanation of how port elevations are estimated, see each model's help file.</Description>
        <Type>Enumeration</Type>
        <Default>Disabled</Default>
        <Global />
        <Values>
          <Value>Disabled</Value>
          <Value>Manual</Value>
          <Value>Automatic</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Phases</Name>
        <Description>Sink option to override the fluid phase selection\n     Fluid: The FluidType's phases are applied.\n     Vapor: The phases are set to Vapor.\n     Liquid: The phases are set to Liquid.\n     VLE: The phases are set to VLE.\n     VLWE: The phases are set to VLWE.\n     VLLE: The phases are set to VLLE.</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Fluid</Default>
        <Favorite />
        <Values>
          <Value>Fluid</Value>
          <Value>Vapor</Value>
          <Value>Liquid</Value>
          <Value>VLE</Value>
          <Value>VLWE</Value>
          <Value>VLLE</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>PhaseNoOverride</Name>
        <Description>Sink PhaseOverride parameter defaulted to NoOverride which is used for the connection to the State.PhaseOverride when Phases = Fluid</Description>
        <Type>Enumeration</Type>
        <Default>NoOverride</Default>
        <Values>
          <Value>NoOverride</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>ReverseFlow</Name>
        <Description>Sink reverse flow setting in Process mode\n    Reflected: The reverse flow properties are same as forward flow.\n    Defined: The reverse flow (Tr, Mr) properties can be defined.</Description>
        <Type>Enumeration</Type>
        <Group>Reverse Flow</Group>
        <Default>Reflected</Default>
        <Favorite />
        <Values>
          <Value>Reflected</Value>
          <Value>Defined</Value>
        </Values>
      </Parameter>
    </Parameters>
    <Conditions>
      <Condition>
        <Name>CMP</Name>
        <Description>FluidType is compositional</Description>
        <Expression>FluidType.Class = Compositional </Expression>
      </Condition>
      <Condition>
        <Name>ComponentsMassFractions</Name>
        <Description>Components set to mass fractions</Description>
        <Expression>(Components = MassFractions) or (Components = Global and GlobalComponents = MassFractions)</Expression>
      </Condition>
      <Condition>
        <Name>ComponentsMassRates</Name>
        <Description>Components set to mass rates</Description>
        <Expression>(Components = MassRates) or (Components = Global and GlobalComponents = MassRates)</Expression>
      </Condition>
      <Condition>
        <Name>ComponentsMassFractionRates</Name>
        <Description>Components set to mass fraction rates</Description>
        <Expression>(Components = MassFractionRates) or (Components = Global and GlobalComponents = MassFractionRates)</Expression>
      </Condition>
      <Condition>
        <Name>ComponentsMoleFractions</Name>
        <Description>Components set to mole fraction</Description>
        <Expression>(Components = MoleFractions) or (Components = Global and GlobalComponents = MoleFractions)</Expression>
      </Condition>
      <Condition>
        <Name>ComponentsMoleRates</Name>
        <Description>Components set to mole rates</Description>
        <Expression>(Components = MoleRates) or (Components = Global and GlobalComponents = MoleRates)</Expression>
      </Condition>
      <Condition>
        <Name>ComponentsMoleFractionRates</Name>
        <Description>Components set to mole fraction rates</Description>
        <Expression>(Components = MoleFractionRates) or (Components = Global and GlobalComponents = MoleFractionRates)</Expression>
      </Condition>
      <Condition>
        <Name>CMPMas</Name>
        <Description>Compositional fluid and components set to mass fraction or mass fraction rate</Description>
        <Expression>CMP and (ComponentsMassFractions or ComponentsMassFractionRates or ComponentsAll or Industry = Petro)</Expression>
      </Condition>
      <Condition>
        <Name>CMPRateMol</Name>
        <Description>Compositional fluid and components set to mole rate, mole fraction rate, or all</Description>
        <Expression>(CMP or FluidType.Class = IsomericHydrogen) and (ComponentsMoleRates or ComponentsMoleFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>CMPRatMas</Name>
        <Description>Compositional fluid and components set to mass rate, mass fraction rate, or all</Description>
        <Expression>CMP and (ComponentsMassRates or ComponentsMassFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>VLE</Name>
        <Description>Vapor liquid equilibrium</Description>
        <Expression>CMP and ((FluidType.Phase = VLE and Phases = Fluid) or (Phases = VLE))</Expression>
      </Condition>
      <Condition>
        <Name>VLEMol</Name>
        <Description>Vapor liquid equilibrium and components are mole fraction, mole fraction rate, or all</Description>
        <Expression>(VLE or FluidType.Class = IsomericHydrogen) and (ComponentsMoleFractions or ComponentsMoleFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>VLEMas</Name>
        <Description>Vapor liquid equilibrium and components are mass fraction, mass fraction rate, or all</Description>
        <Expression>VLE and (ComponentsMassFractions or ComponentsMassFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>VLLE</Name>
        <Description>Vapor liquid liquid equilibrium</Description>
        <Expression>CMP and (((FluidType.Phase = VLWE or FluidType.Phase = VLLE) and Phases = Fluid) Or Phases = VLWE or Phases = VLLE)</Expression>
      </Condition>
      <Condition>
        <Name>VLLEMol</Name>
        <Description>Vapor liquid liquid equilibrium and components are mole fraction, mole fraction rate, or all</Description>
        <Expression>VLLE and (ComponentsMoleFractions or ComponentsMoleFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>VLLEMas</Name>
        <Description>Vapor liquid liquid equilibrium and components are mass fraction, mass fraction rate, or all</Description>
        <Expression>VLLE and (ComponentsMassFractions or ComponentsMassFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>CMPNSP</Name>
        <Description>Multiple phases present</Description>
        <Expression>CMP and (VLE or VLLE)</Expression>
      </Condition>
      <Condition>
        <Name>CMPNSPMol</Name>
        <Description>Multiple phases present and components are mole fraction, mole fraction rate, or all</Description>
        <Expression>(CMPNSP or FluidType.Class = IsomericHydrogen) and ComponentsMoleFractions or (ComponentsMoleFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>CMPNSPMas</Name>
        <Description>Multiple phases present and components are mass fraction, mass fraction rate, or all</Description>
        <Expression>CMPNSP and (ComponentsMassFractions or ComponentsMassFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>MC</Name>
        <Description>Mode check for warnings</Description>
        <Expression>ModeCheck = AllModes or Mode &lt;&gt; Process</Expression>
      </Condition>
      <Condition>
        <Name>CMPFD</Name>
        <Description>Compositional fluid in fluid flow for warnings</Description>
        <Expression>CMP and Mode &lt;&gt; Process</Expression>
      </Condition>
      <Condition>
        <Name>Petro</Name>
        <Description>Compositional petroleum fluid</Description>
        <Expression>CMP and Industry = Petro</Expression>
      </Condition>
      <Condition>
        <Name>NSPMas</Name>
        <Description>Multiple phases present and component is mass or all</Description>
        <Expression>CMPNSP and (ComponentsMassFractions or ComponentsMassRates or ComponentsMassFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>SPmol</Name>
        <Description>Single phase and components are mole fraction, mole fraction rate, or all</Description>
        <Expression>(not CMPNSP) and (Components &lt;&gt; MassFractions and Components &lt;&gt; MassRates and Components &lt;&gt; MassFractionRates)</Expression>
      </Condition>
      <Condition>
        <Name>NSPmol</Name>
        <Description>Multiple phases present and component is mole or all</Description>
        <Expression>CMPNSP and (Components &lt;&gt; MassFractions and Components &lt;&gt; MassRates and Components &lt;&gt; MassFractionRates)</Expression>
      </Condition>
      <Condition>
        <Name>SPMas</Name>
        <Description>Single phase and components are mass fraction, mass fraction rate, or all</Description>
        <Expression>(not CMPNSP) and (ComponentsMassFractions or ComponentsMassRates or ComponentsMassFractionRates or ComponentsAll)</Expression>
      </Condition>
      <Condition>
        <Name>Elev</Name>
        <Description>Elevation</Description>
        <Expression>Elevations &lt;&gt; Disabled</Expression>
      </Condition>
      <Condition>
        <Name>PhaseOvrrde</Name>
        <Description>Phase is specified by the user</Description>
        <Expression>Phases &lt;&gt; Fluid</Expression>
      </Condition>
      <Condition>
        <Name>PhaseOvrrdeNo</Name>
        <Description>Phase is automatically set by the fluid</Description>
        <Expression>Phases = Fluid</Expression>
      </Condition>
      <Condition>
        <Name>EOSorGS</Name>
        <Description>Equation of state is selected</Description>
        <Expression>FluidType.System = SRK or FluidType.System = PR or FluidType.System = SRKM or FluidType.System = PRM or FluidType.System = SRKH or FluidType.System = PSRK or FluidType.System = GS  or FluidType.System = IGS</Expression>
      </Condition>
      <Condition>
        <Name>ComponentsAll</Name>
        <Description>Components is set to all</Description>
        <Expression>(Components = All) or (Components = Global and GlobalComponents = All)</Expression>
      </Condition>
      <Condition>
        <Name>RevFlowReflected</Name>
        <Description>Reverse flow is reflected</Description>
        <Expression>ReverseFlow = Reflected</Expression>
      </Condition>
      <Condition>
        <Name>RevFlowDefined</Name>
        <Description>Reverse flow is specified</Description>
        <Expression>ReverseFlow = Defined</Expression>
      </Condition>
      <Condition>
        <Name>RevFlowReflectedPro</Name>
        <Description>Reverse flow is reflected and mode is process</Description>
        <Expression>RevFlowReflected and Mode = Process</Expression>
      </Condition>
      <Condition>
        <Name>HasSolids</Name>
        <Expression>FluidType.HasSolids = 1</Expression>
      </Condition>
    </Conditions>
    <Connections>
      <Connection>
        <Name>PC1</Name>
        <Type>Parameter</Type>
        <From>In.FluidType</From>
        <To>FluidType</To>
      </Connection>
      <Connection>
        <Name>PC2</Name>
        <Type>Parameter</Type>
        <From>In.FluidType</From>
        <To>State.FluidType</To>
      </Connection>
      <Connection>
        <Name>VC1</Name>
        <Type>Variable</Type>
        <From>In.F</From>
        <To>F</To>
      </Connection>
      <Connection>
        <Name>vc3</Name>
        <Type>Variable</Type>
        <From>In.P</From>
        <To>P</To>
      </Connection>
      <Connection>
        <Name>C4</Name>
        <Type>Variable</Type>
        <From>In.H</From>
        <To>H</To>
      </Connection>
      <Connection>
        <Name>C6</Name>
        <Type>Variable</Type>
        <From>In.P</From>
        <To>State.P</To>
      </Connection>
      <Connection>
        <Name>C5</Name>
        <Type>Variable</Type>
        <From>State.T</From>
        <To>T</To>
      </Connection>
      <Connection>
        <Name>Conn1</Name>
        <Condition>SPmol</Condition>
        <Type>Variable</Type>
        <From>State.VF</From>
        <To>VF</To>
      </Connection>
      <Connection>
        <Name>Conn4</Name>
        <Condition>NSPmol</Condition>
        <Type>Variable</Type>
        <From>State.VFu</From>
        <To>VF</To>
      </Connection>
      <Connection>
        <Name>Conn2</Name>
        <Condition>CMP</Condition>
        <Type>Variable</Type>
        <From>State.z</From>
        <To>z</To>
      </Connection>
      <Connection>
        <Name>Conn14</Name>
        <Condition>CMPNSPMol</Condition>
        <Type>Variable</Type>
        <From>State.y</From>
        <To>y</To>
      </Connection>
      <Connection>
        <Name>Conn15</Name>
        <Condition>VLEMol</Condition>
        <Type>Variable</Type>
        <From>State.x</From>
        <To>x</To>
      </Connection>
      <Connection>
        <Name>Conn16</Name>
        <Condition>VLLE</Condition>
        <Type>Variable</Type>
        <From>State.x1</From>
        <To>x1</To>
      </Connection>
      <Connection>
        <Name>Conn17</Name>
        <Condition>VLLE</Condition>
        <Type>Variable</Type>
        <From>State.x2</From>
        <To>x2</To>
      </Connection>
      <Connection>
        <Name>MC1</Name>
        <Type>Variable</Type>
        <From>In.setp</From>
        <To>setp</To>
      </Connection>
      <Connection>
        <Name>ConnEl</Name>
        <Condition>Elev</Condition>
        <Type>Variable</Type>
        <From>In.El</From>
        <To>El</To>
      </Connection>
      <Connection>
        <Name>PHASEOVR1a</Name>
        <Condition>PhaseOvrrde</Condition>
        <Type>Parameter</Type>
        <From>Phases</From>
        <To>State.PhaseOverride</To>
      </Connection>
      <Connection>
        <Name>PHASEOVR1b</Name>
        <Condition>PhaseOvrrdeNo</Condition>
        <Type>Parameter</Type>
        <From>PhaseNoOverride</From>
        <To>State.PhaseOverride</To>
      </Connection>
      <Connection>
        <Name>Conn5</Name>
        <Condition>VLLEMol</Condition>
        <Type>Variable</Type>
        <From>State.L1F</From>
        <To>L1F</To>
      </Connection>
      <Connection>
        <Name>Conn6</Name>
        <Condition>VLLEMol</Condition>
        <Type>Variable</Type>
        <From>State.L2F</From>
        <To>L2F</To>
      </Connection>
      <Connection>
        <Name>RF01</Name>
        <Condition>RevFlowDefined</Condition>
        <Type>Parameter</Type>
        <From>FluidType</From>
        <To>RevState.FluidType</To>
      </Connection>
      <Connection>
        <Name>RF02</Name>
        <Condition>RevFlowDefined</Condition>
        <Type>Variable</Type>
        <From>P</From>
        <To>RevState.P</To>
      </Connection>
      <Connection>
        <Name>RF03</Name>
        <Condition>RevFlowDefined</Condition>
        <Type>Variable</Type>
        <From>Tr</From>
        <To>RevState.T</To>
      </Connection>
      <Connection>
        <Name>RF04</Name>
        <Condition>RevFlowDefined</Condition>
        <Type>Variable</Type>
        <From>zr</From>
        <To>RevState.z</To>
      </Connection>
      <Connection>
        <Name>RF05</Name>
        <Condition>RevFlowDefined</Condition>
        <Type>Variable</Type>
        <From>RevState.H</From>
        <To>Hr</To>
      </Connection>
      <Connection>
        <Name>RF06</Name>
        <Condition>RevFlowDefined</Condition>
        <Type>Variable</Type>
        <From>RevState.VF</From>
        <To>VFr</To>
      </Connection>
      <Connection>
        <Name>RF07</Name>
        <Type>Variable</Type>
        <From>In.zr</From>
        <To>zr</To>
      </Connection>
    </Connections>
    <Variables>
      <Variable>
        <Name>W</Name>
        <Description>Sink mass flow (forward flow)</Description>
        <Type>Mass Flow</Type>
        <Group>Operation</Group>
        <Favorite />
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>F</Name>
        <Description>Sink molar / standard volume flow</Description>
        <Type>Mole Flow</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>-1000000</Min>
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>Q</Name>
        <Description>Sink actual volumetric flow (forward flow)</Description>
        <Type>Vol Flow</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>-1000000</Min>
        <Default>0.001</Default>
      </Variable>
      <Variable>
        <Name>P</Name>
        <Description>Sink pressure</Description>
        <Type>Pressure</Type>
        <Group>Operation</Group>
        <FluidFlowMode />
        <DynamicMode />
        <Required />
        <Favorite />
        <Min>FluidType.PMin</Min>
        <Max>FluidType.PMax</Max>
        <Default>FluidType.Pressure</Default>
      </Variable>
      <Variable>
        <Name>T</Name>
        <Description>Sink temperature (forward flow)</Description>
        <Type>Temperature</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>FluidType.TMin</Min>
        <Max>FluidType.TMax</Max>
        <Default>FluidType.Temperature</Default>
      </Variable>
      <Variable>
        <Name>VF</Name>
        <Description>Sink molar vapor fraction (forward flow)</Description>
        <Condition>SPmol</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>VF</Name>
        <Description>Sink molar vapor fraction (forward flow)\nVLE: unbounded VFu where VFu &lt; 0 is subcooled, VFu = 0 is the bubble point, VFu = 1 is the dew point, and VFu &gt; 1 is superheated\nVLLE: bounded VF (0 ≤ VF ≤ 1) where VF = 0 is the bubble point (or subcooled) and VF = 1 is the dew point (or superheated)</Description>
        <Condition>NSPmol</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Favorite />
        <Max>0</Max>
      </Variable>
      <Variable>
        <Name>VFm</Name>
        <Description>Sink mass vapor fraction (forward flow)</Description>
        <Condition>SPMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>VFm</Name>
        <Description>Sink mass vapor fraction (forward flow)\nVLE: unbounded VFu where VFu &lt; 0 is subcooled, VFu = 0 is the bubble point, VFu = 1 is the dew point, and VFu &gt; 1 is superheated\nVLLE: bounded VF (0 ≤ VF ≤ 1) where VF = 0 is the bubble point (or subcooled) and VF = 1 is the dew point (or superheated)</Description>
        <Condition>NSPMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Favorite />
        <Max>0</Max>
      </Variable>
      <Variable>
        <Name>L1F</Name>
        <Description>Sink molar liquid 1 fraction</Description>
        <Condition>VLLEMol</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>L2F</Name>
        <Description>Sink molar liquid 2 fraction</Description>
        <Condition>VLLEMol</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>LFm</Name>
        <Description>Sink mass liquid fraction</Description>
        <Condition>VLLEMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>L1Fm</Name>
        <Description>Sink mass liquid 1 fraction</Description>
        <Condition>VLLEMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>L2Fm</Name>
        <Description>Sink mass liquid 2 fraction</Description>
        <Condition>VLLEMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>H</Name>
        <Description>Sink enthalpy </Description>
        <Type>Molar Enthalpy</Type>
        <Group>Operation</Group>
        <Default>1000</Default>
      </Variable>
      <Variable>
        <Name>Fc</Name>
        <Description>Sink component mole flows</Description>
        <Condition>CMPRateMol</Condition>
        <Type>Mole Flow</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <Favorite />
        <Min>-1000000</Min>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>Wc</Name>
        <Description>Sink component mass flows</Description>
        <Condition>CMPRatMas</Condition>
        <Type>Mass Flow</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>z</Name>
        <Description>Sink bulk molar composition</Description>
        <Condition>CMP</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>zm</Name>
        <Description>Sink bulk mass composition</Description>
        <Condition>CMPMas</Condition>
        <Type>Mass Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>y</Name>
        <Description>Sink vapor phase molar composition</Description>
        <Condition>CMPNSPMol</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>ym</Name>
        <Description>Sink vapor phase mass composition</Description>
        <Condition>CMPNSPMas</Condition>
        <Type>Mass Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>x</Name>
        <Description>Sink liquid phase molar composition</Description>
        <Condition>VLEMol</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>xm</Name>
        <Description>Sink liquid phase mass composition</Description>
        <Condition>VLEMas</Condition>
        <Type>Mass Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>x1</Name>
        <Description>Sink liquid 1 molar composition</Description>
        <Condition>VLLEMol</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>x1m</Name>
        <Description>Sink liquid 1 mass composition</Description>
        <Condition>VLLEMas</Condition>
        <Type>Mass Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>x2</Name>
        <Description>Sink liquid 2 molar composition</Description>
        <Condition>VLLEMol</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>x2m</Name>
        <Description>Sink liquid 2 mass composition</Description>
        <Condition>VLLEMas</Condition>
        <Type>Mass Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Composition</Group>
        <ProcessMode Lock="One">false</ProcessMode>
        <FluidFlowMode Lock="One">false</FluidFlowMode>
        <DynamicMode Lock="One">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>Hr</Name>
        <Description>Sink enthalpy (reverse flow)</Description>
        <Condition>RevFlowReflected</Condition>
        <Type>Molar Enthalpy</Type>
        <Group>Reverse Flow</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">true</FluidFlowMode>
        <DynamicMode Lock="Always">true</DynamicMode>
      </Variable>
      <Variable>
        <Name>zr</Name>
        <Description>Sink composition (reverse flow)</Description>
        <Condition>RevFlowReflected</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Reverse Flow</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">true</FluidFlowMode>
        <DynamicMode Lock="Always">true</DynamicMode>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>Tr</Name>
        <Description>Sink temperature (reverse flow)</Description>
        <Condition>RevFlowDefined</Condition>
        <Type>Temperature</Type>
        <Group>Reverse Flow</Group>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
        <Favorite />
        <Min>FluidType.TMin</Min>
        <Max>FluidType.TMax</Max>
        <Default>FluidType.Temperature</Default>
      </Variable>
      <Variable>
        <Name>VFr</Name>
        <Description>Sink vapor fraction (reverse flow)</Description>
        <Condition>RevFlowDefined</Condition>
        <Type>Molar Composition</Type>
        <Group>Reverse Flow</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>Mr</Name>
        <Description>Sink molar composition (reverse flow)</Description>
        <Condition>RevFlowDefined</Condition>
        <Type>Moles</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Reverse Flow</Group>
        <ProcessMode Lock="One">true</ProcessMode>
        <FluidFlowMode Lock="One">true</FluidFlowMode>
        <DynamicMode Lock="One">true</DynamicMode>
        <Favorite />
        <Min>0</Min>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>Mrt</Name>
        <Description>Sink total moles (reverse flow)</Description>
        <Condition>RevFlowDefined</Condition>
        <Type>Moles</Type>
        <Group>Reverse Flow</Group>
        <Favorite />
        <Min>0</Min>
      </Variable>
      <Variable>
        <Name>Hr</Name>
        <Description>Sink enthalpy (reverse flow)</Description>
        <Condition>RevFlowDefined</Condition>
        <Type>Molar Enthalpy</Type>
        <Group>Reverse Flow</Group>
      </Variable>
      <Variable>
        <Name>zr</Name>
        <Description>Sink composition (reverse flow)</Description>
        <Condition>RevFlowDefined</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Reverse Flow</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>setp</Name>
        <Description>Sink inlet pressure is set by upstream device</Description>
        <Type>Dimensionless</Type>
        <Default>0</Default>
      </Variable>
      <Variable>
        <Name>zrTot</Name>
        <Description>Sink composition (reverse flow) total</Description>
        <Condition>CMP</Condition>
        <Type>Molar Composition</Type>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Max>0</Max>
      </Variable>
      <Variable>
        <Name>L</Name>
        <Description>Sink standard liquid volumetric flow (60 F and 1 atm)</Description>
        <Condition>Petro</Condition>
        <Type>Std Liquid Vol Flow</Type>
        <Group>Petroleum Industry</Group>
        <Favorite />
        <Min>-1000000</Min>
      </Variable>
      <Variable>
        <Name>Gravity</Name>
        <Description>Sink specific gravity, API gravity, or liquid density at standard conditions (60 F and 1 atm)</Description>
        <Condition>Petro</Condition>
        <Type>Standard Liquid Density</Type>
        <Group>Petroleum Industry</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>minSG60F</Name>
        <Description>Sink minimum SG @ 60 F to check for missing standard specific gravity</Description>
        <Condition>Petro</Condition>
        <Type>Specific Gravity</Type>
        <Min>0</Min>
      </Variable>
      <Variable>
        <Name>El</Name>
        <Description>Sink elevation</Description>
        <Condition>Elev</Condition>
        <Type>Elevation</Type>
        <Group>Elevation</Group>
        <Favorite />
        <Min>-1000</Min>
        <Max>1000</Max>
      </Variable>
      <Variable>
        <Name>sumy</Name>
        <Description>Sink sum of vapor composition to identify where there is a vapor liquid equilibrium</Description>
        <Condition>HasSolids</Condition>
        <Type>Molar Composition</Type>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Max>0</Max>
        <Default>1</Default>
      </Variable>
    </Variables>
    <Equations>
      <Equation>
        <Name>W2</Name>
        <Description>Sink mass flow</Description>
        <Formula>W = F * State.MW</Formula>
      </Equation>
      <Equation>
        <Name>Q2</Name>
        <Description>Sink actual volumetric flow</Description>
        <Formula>Q = F * State.V</Formula>
      </Equation>
      <Equation>
        <Name>WZ1</Name>
        <Description>Sink mole to mass fraction conversion</Description>
        <Condition>CMPMas</Condition>
        <Formula>zm * sum(State.z * FluidType.MW) = State.z * FluidType.MW </Formula>
      </Equation>
      <Equation>
        <Name>WZ2</Name>
        <Description>Sink vapor mole to mass fraction conversion</Description>
        <Condition>CMPNSPMas</Condition>
        <Formula>ym[not FluidType.Solids] * State.MWv = State.y * FluidType.MW</Formula>
      </Equation>
      <Equation>
        <Name>WZ2b</Name>
        <Description>Sink vapor mass fraction of solids is always zero</Description>
        <Condition>CMPNSPMas</Condition>
        <Formula>ym[FluidType.Solids] = 0  </Formula>
      </Equation>
      <Equation>
        <Name>WZ3</Name>
        <Description>Sink liquid mole to mass fraction conversion</Description>
        <Condition>VLEMas</Condition>
        <Formula>xm * sum(State.x * FluidType.MW) = State.x * FluidType.MW </Formula>
      </Equation>
      <Equation>
        <Name>WZ4</Name>
        <Description>Sink liquid 1 mole to mass fraction conversion</Description>
        <Condition>VLLEMas</Condition>
        <Formula>x1m * sum(State.x1 * FluidType.MW) = State.x1 * FluidType.MW </Formula>
      </Equation>
      <Equation>
        <Name>WZ5</Name>
        <Description>Sink liquid 2 mole to mass fraction conversion</Description>
        <Condition>VLLEMas</Condition>
        <Formula>x2m * sum(State.x2 * FluidType.MW) = State.x2 * FluidType.MW </Formula>
      </Equation>
      <Equation>
        <Name>Eqn8</Name>
        <Condition>CMPRateMol</Condition>
        <Formula>Fc = In.F * State.z</Formula>
      </Equation>
      <Equation>
        <Name>Eqn9</Name>
        <Condition>CMPRatMas</Condition>
        <Formula>Wc = In.F * State.z * FluidType.MW</Formula>
      </Equation>
      <Equation>
        <Name>zrevtotal</Name>
        <Condition>CMP</Condition>
        <Formula>zrTot = sum(zr)</Formula>
      </Equation>
      <Equation>
        <Name>EqnL</Name>
        <Description>Sink standard liquid volumetric flow (60 F and 1 atm)</Description>
        <Condition>Petro</Condition>
        <Formula>Gravity * L = W</Formula>
      </Equation>
      <Equation>
        <Name>EqnSLD</Name>
        <Description>Sink specific gravity, API gravity, or liquid density at standard conditions (60 F and 1 atm)</Description>
        <Condition>Petro</Condition>
        <Formula>999.016 = Gravity * sum(zm / max(FluidType.SG60F, 1E-9))</Formula>
      </Equation>
      <Equation>
        <Name>EqnMinSG60</Name>
        <Description>Sink minimum SG @60 F to check for missing standard specific gravity</Description>
        <Condition>Petro</Condition>
        <Formula>minSG60F = min(FluidType.SG60F)</Formula>
      </Equation>
      <Equation>
        <Name>EqnVF1</Name>
        <Condition>NSPMas</Condition>
        <Formula>VFm * State.MW = State.VFu * State.MWv</Formula>
      </Equation>
      <Equation>
        <Name>EqnVF2</Name>
        <Condition>SPMas</Condition>
        <Formula>VFm = State.VF </Formula>
      </Equation>
      <Equation>
        <Name>LF1</Name>
        <Description>Sink mass liquid 1 fraction</Description>
        <Condition>VLLEMas</Condition>
        <Formula>L1Fm * State.MW = State.L1F * State.MWl1</Formula>
      </Equation>
      <Equation>
        <Name>LF2</Name>
        <Description>Sink mass liquid 2 fraction</Description>
        <Condition>VLLEMas</Condition>
        <Formula>L2Fm * State.MW = State.L2F * State.MWl2</Formula>
      </Equation>
      <Equation>
        <Name>LF3</Name>
        <Description>Sink mass liquid fraction</Description>
        <Condition>VLLEMas</Condition>
        <Formula>LFm = L1Fm + L2Fm</Formula>
      </Equation>
      <Equation>
        <Name>RF08</Name>
        <Description>Sink reverse flow enthalpy</Description>
        <Condition>RevFlowReflectedPro</Condition>
        <Formula>Hr = tear(In.H)</Formula>
      </Equation>
      <Equation>
        <Name>RF09</Name>
        <Description>Sink reverse component flow</Description>
        <Condition>RevFlowReflectedPro</Condition>
        <Formula>zr = tear(In.z)</Formula>
      </Equation>
      <Equation>
        <Name>RF10</Name>
        <Formula>State.H = select(In.F, In.H, In.Hr)</Formula>
      </Equation>
      <Equation>
        <Name>RF11</Name>
        <Formula>State.z = select(In.F, In.z, In.zr)</Formula>
      </Equation>
      <Equation>
        <Name>RF12</Name>
        <Formula>In.Hr = Hr</Formula>
      </Equation>
      <Equation>
        <Name>RF13</Name>
        <Condition>RevFlowDefined</Condition>
        <Formula>Mrt = sum(Mr)</Formula>
      </Equation>
      <Equation>
        <Name>RF14</Name>
        <Condition>RevFlowDefined</Condition>
        <Formula>zr * Mrt = Mr</Formula>
      </Equation>
      <Equation>
        <Name>EqnSumY</Name>
        <Condition>HasSolids</Condition>
        <Formula>sumy = sum(State.y)</Formula>
      </Equation>
    </Equations>
    <Models>
      <Model>
        <Name>State</Name>
        <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
      </Model>
      <Model>
        <Name>RevState</Name>
        <Condition>RevFlowDefined</Condition>
        <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
      </Model>
    </Models>
    <Ports>
      <Port>
        <Name>In</Name>
        <Library Version="8.2.0">Submodels</Library>
        <Type>FlowPort</Type>
      </Port>
    </Ports>
    <Groups>
      <Group>
        <Name>Configuration</Name>
      </Group>
      <Group>
        <Name>Operation</Name>
        <IsExpandedByDefault>true</IsExpandedByDefault>
      </Group>
      <Group>
        <Name>Composition</Name>
        <IsExpandedByDefault>true</IsExpandedByDefault>
      </Group>
      <Group>
        <Name>Petroleum Industry</Name>
        <IsExpandedByDefault>true</IsExpandedByDefault>
      </Group>
      <Group>
        <Name>Elevation</Name>
        <Description>Elevation variables for hydraulic calculations. To view and edit elevations, set Elevations = Manual or Automatic.</Description>
      </Group>
      <Group>
        <Name>Reverse Flow</Name>
        <Description>Reverse flow properties</Description>
      </Group>
    </Groups>
    <Messages>
      <Message>
        <Name>ModeCheck1</Name>
        <Condition>MC</Condition>
        <Expression>setp = 1</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Add a flow calculating model before the sink such as a pipe or valve, or set the Stream Flow Resistance, for Fluid Flow and Dynamics modes.</DisplayMessage>
      </Message>
      <Message>
        <Name>zNormalized</Name>
        <Condition>CMPFD</Condition>
        <Expression>zrTot &gt; 1.000001 or zrTot &lt; 0.999999</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>The total molar reverse flow composition does not sum to 100%. Please normalize the reverse flow composition.</DisplayMessage>
      </Message>
      <Message>
        <Name>PetroPropertyWarning</Name>
        <Condition>Petro</Condition>
        <Expression>minSG60F = 0</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Petro property calculations may not be accurate. SG60F data is missing or equals zero for at least one component. Confirm that values are correct in the Thermo Data Manager program.</DisplayMessage>
      </Message>
      <Message>
        <Name>VLWEforEOSorGSonly</Name>
        <Expression>not EOSorGS and Phases = VLWE</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Phases = VLWE is only recommended for fluids that use any of the following methods: SRK, PR, SRKM, PRM, SRKH, PSRK, GS, IGS. Please review the selection for Phases.</DisplayMessage>
      </Message>
      <Message>
        <Name>NoVLEquilibrium</Name>
        <Condition>HasSolids</Condition>
        <Expression>sumy &lt; 1e-16</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Pure solid stream detected. Please consider adding trace amounts of a non-solid component to avoid numerical problems.</DisplayMessage>
      </Message>
    </Messages>
    <GraphicData>
      <Icon>
        <DefaultIcon>Default</DefaultIcon>
