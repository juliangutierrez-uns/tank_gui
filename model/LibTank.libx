        <From>FlowCalc.W</From>
        <To>W</To>
      </Connection>
      <Connection>
        <Name>C13</Name>
        <Condition>SingleSNFR</Condition>
        <Type>Variable</Type>
        <From>FlowCalc.DP</From>
        <To>DP</To>
      </Connection>
      <Connection>
        <Name>C20</Name>
        <Type>Variable</Type>
        <From>In.H</From>
