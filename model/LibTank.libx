  </Model>
  <Model>
    <Type>Valve</Type>
    <Description>Manual or automatic control valve
(SteamLib and Process)</Description>
    <NamePrefix>XV</NamePrefix>
    <NameStartingNumber>1</NameStartingNumber>
    <Parameters>
      <Parameter>
        <Name>FluidType</Name>
        <Description>Valve fluid type</Description>
        <Type>FluidType</Type>
        <Default></Default>
      </Parameter>
      <Parameter>
        <Name>ModeCheck</Name>
        <Description>Global check for mode change warnings while still in Process mode</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Process</Default>
        <Favorite />
        <Global />
        <Values>
          <Value>Process</Value>
          <Value>AllModes</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>FlowType</Name>
        <Description>Valve compressible, incompressible, or flow range calculations</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Incompressible</Default>
        <Favorite />
        <Values>
          <Value>Incompressible</Value>
          <Value>Compressible</Value>
          <Value>FlowRange</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>CheckValve</Name>
        <Description>Valve check valve to prevent reverse flow </Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>NoCheck</Default>
        <Favorite />
        <Values>
          <Value>Check</Value>
          <Value>NoCheck</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Tc</Name>
        <Description>Valve time to open/close</Description>
        <Type>Time</Type>
        <Group>Actuator </Group>
        <Default>5</Default>
        <Invariant />
        <Min>0.001</Min>
      </Parameter>
      <Parameter>
        <Name>xT</Name>
        <Description>Valve critical flow pressure ratio coefficient</Description>
        <Type>Dimensionless</Type>
        <Group>Valve Data</Group>
        <Default>0.7</Default>
        <Invariant />
        <Max>1</Max>
        <Min>0</Min>
      </Parameter>
      <Parameter>
        <Name>CpCv</Name>
        <Description>Valve gas heat capacity ratio</Description>
        <Type>Dimensionless</Type>
        <Group>Valve Data</Group>
        <Default>1.3</Default>
        <Max>2</Max>
        <Min>1</Min>
      </Parameter>
      <Parameter>
        <Name>FRramp</Name>
        <Description>Global flow parameter to ramp from forward stream\nconditions to reverse stream conditions.\n\nFor steady state simulations, use a value smaller than\nthe smallest flowrate in your simulation.\n\nFor dynamic simulations, the FRramp will cause the\nthermodynamic state calculations to use the forward\nenthalpy/composition when the flow is greater than\nFRramp, reverse enthalpy/composition when flow is\nless than negative FRramp, and ramp the values in\nbetween negative FRramp and FRramp as flow reversal\ntakes place.\n\nA larger value will smooth out sudden discontinuities\nfor dynamics but stream properties may appear wrong\nnear zero flow in steady state simulations.</Description>
        <Type>Mole Flow</Type>
        <Group>Configuration</Group>
        <Default>0.001</Default>
        <Global />
      </Parameter>
      <Parameter>
        <Name>Elevations</Name>
        <Description>Global selection to enable the specification of equipment port elevations.\n     Disabled: disable specifications for port elevations.  The elevation change (DE) can still be specified in the Pipe and PipeRig models.\n     Manual: manually specify port elevations. DE in the Pipe and PipeRig models can be swapped for port elevation specifications.\n     Automatic: automatically calculate port elevations using equipment geometry and configuration options for select models (Column, Drum, etc).\n\nWhen automatic elevations are enabled, an elevation specification must be removed from each inlet stream of impacted models (for example, remove the DE specification from an inlet Pipe).\nOther model elevations must still be manually specified. For an explanation of how port elevations are estimated, see each model's help file.</Description>
        <Type>Enumeration</Type>
        <Default>Disabled</Default>
        <Global />
        <Values>
          <Value>Disabled</Value>
          <Value>Manual</Value>
          <Value>Automatic</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Char</Name>
        <Description>Valve characteristic curve</Description>
        <Type>Enumeration</Type>
        <Group>Valve Data</Group>
        <Default>Linear</Default>
        <Favorite />
        <Values>
          <Value>Linear</Value>
          <Value>EqualPctLeak</Value>
          <Value>EqualPercent</Value>
          <Value>QuickOpening</Value>
          <Value>UserDefined</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>ActuatorType</Name>
        <Description>Valve actuator type: first order or constant velocity</Description>
        <Type>Enumeration</Type>
        <Group>Actuator </Group>
        <Default>FirstOrder</Default>
        <Values>
          <Value>FirstOrder</Value>
          <Value>ConstVelocity</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Leak</Name>
        <Description>Valve leak fraction</Description>
        <Type>Fraction</Type>
        <Group>Valve Data</Group>
        <Default>1E-09</Default>
        <Invariant />
      </Parameter>
      <Parameter>
        <Name>MotiveModelType</Name>
        <Description>Valve motive power replaceable submodel.\n     Keep 'NoMotivePwr' submodel if the valve does not have a defined motive power.\n     Select 'MotiveAir' submodel to set air as the motive power.\n     Create a copy of 'MotiveAir' and rename variable 'Air' to customize motive power/fluid for the valve.</Description>
        <Type>ModelType</Type>
        <Group>Actuator </Group>
        <Default>Process.NoMotivePwr</Default>
        <Favorite />
      </Parameter>
      <Parameter>
        <Name>FailPosition</Name>
        <Description>Valve fail position selection.\n     Closed: valve closes when motive power failed or tripped.\n     Open: valve opens when motive power failed or tripped.\n     Last: valve holds the last known position when motive power failed or tripped.</Description>
        <Type>Enumeration</Type>
        <Group>Actuator </Group>
        <Default>Closed</Default>
        <Favorite />
        <Invariant />
        <Values>
          <Value>Closed</Value>
          <Value>Open</Value>
          <Value>Last</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Phases</Name>
        <Description>Valve option to override the fluid phase selection\n     Fluid: The FluidType's phases are applied.\n     Vapor: The phases are set to Vapor.\n     Liquid: The phases are set to Liquid.\n     VLE: The phases are set to VLE.\n     VLWE: The phases are set to VLWE.\n     VLLE: The phases are set to VLLE.</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Fluid</Default>
        <Favorite />
        <Values>
          <Value>Fluid</Value>
          <Value>Vapor</Value>
          <Value>Liquid</Value>
          <Value>VLE</Value>
          <Value>VLWE</Value>
          <Value>VLLE</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>PhaseNoOverride</Name>
        <Description>Valve PhaseNoOverride parameter defaulted to NoOverride which is used for the connection to the State.PhaseOverride when Phases = Fluid</Description>
        <Type>Enumeration</Type>
        <Default>NoOverride</Default>
        <Values>
          <Value>NoOverride</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>RFState</Name>
        <Description>Global option to calculate valve flow from forward and reverse stream properties.\n     Single -  Forward and reverse stream properties are mixed in a single flash to\n                   calculate the properties in the direction of flow.\n     Double - Forward and reverse stream properties are flashed separately\n                   and only the properties in the flow direction are used.\nThe RFState option is applicable only when FlowType is either Compressible or Incompressible.</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Double</Default>
        <Favorite />
        <Global />
        <Values>
          <Value>Single</Value>
          <Value>Double</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>DPlin</Name>
        <Description>Valve pressure difference at which flow is assumed to be linear with pressure drop.\nAdjusting value may improve convergence at low flow and reverse flow conditions.</Description>
        <Type>Diff Pressure</Type>
        <Default>1</Default>
        <Min>0</Min>
      </Parameter>
      <Parameter>
        <Name>LineSizedCv</Name>
        <Description>Valve line sized Cv calculation:\n     Actual: specify Cv or calculate from DP, flowrate and position.\n     Other Cv options: calculate Cv based on line size and valve type.\n          See Submodels.ValveCoeff help (Crane Technical Paper 410)\n          for details. Go to PipeData group to select pipe.</Description>
        <Type>Enumeration</Type>
        <Group>Valve Data</Group>
        <Default>Actual</Default>
        <Favorite />
        <Values>
          <Value>Actual</Value>
          <Value>Ball</Value>
          <Value>Gate</Value>
          <Value>Butterfly</Value>
          <Value>Globe</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Standard</Name>
        <Description>Global Standard options:\n     None: ignore piping standards and allow the pipe inside diameter \n          to be calculated/specified to any value.\n     NPS: specify the pipe diameter in Nominal Pipe Size.\n     DN: specify the pipe diameter in Diameter Nominal.\n     JIS A: specify the pipe diameter in Japanese Industrial Standard A.\n     JIS B: specify the pipe diameter in Japanese Industrial Standard B.\n     GOST: specify the pipe diameter in Russian Standard.\n     DIN: specify the pipe diameter in German Standard.</Description>
        <Type>Enumeration</Type>
        <Group>Pipe Data</Group>
        <Default>NPS</Default>
        <Favorite />
        <Global />
        <Invariant />
        <Values>
          <Value>None</Value>
          <Value>NPS</Value>
          <Value>DN</Value>
          <Value>JIS A</Value>
          <Value>JIS B</Value>
          <Value>GOST</Value>
          <Value>DIN</Value>
        </Values>
      </Parameter>
    </Parameters>
    <Conditions>
      <Condition>
        <Name>Comp</Name>
        <Description>Compressible flow for vapors with large DP</Description>
        <Expression>FlowType = Compressible</Expression>
      </Condition>
      <Condition>
        <Name>Incomp</Name>
        <Description>Incompressible flow</Description>
        <Expression>FlowType = Incompressible</Expression>
      </Condition>
      <Condition>
        <Name>Man</Name>
        <Description>No controller connection</Description>
        <Expression>Control.NumberOfConnections = 0</Expression>
      </Condition>
      <Condition>
        <Name>Auto</Name>
        <Description>Controller connection</Description>
        <Expression>Control.NumberOfConnections = 1</Expression>
      </Condition>
      <Condition>
        <Name>LB</Name>
        <Description>Loop back for reverse flow</Description>
        <Expression>Out.NumberOfConnections = 0</Expression>
      </Condition>
      <Condition>
        <Name>Pro</Name>
        <Description>Process mode</Description>
        <Expression>Mode = Process</Expression>
      </Condition>
      <Condition>
        <Name>MC</Name>
        <Description>Fluid Flow or Dynamics mode</Description>
        <Expression>ModeCheck = AllModes or Mode &lt;&gt; Process</Expression>
      </Condition>
      <Condition>
        <Name>FR</Name>
        <Description>Flow is between Wmin and Wmax</Description>
        <Expression>FlowType = FlowRange</Expression>
      </Condition>
      <Condition>
        <Name>NFR</Name>
        <Description>Flow is either compressible or incompressible</Description>
        <Expression>FlowType &lt;&gt; FlowRange</Expression>
      </Condition>
      <Condition>
        <Name>LSCV</Name>
        <Description>Valve line sized Cv is set for calculations based on valve type</Description>
        <Expression>LineSizedCv &lt;&gt; Actual and FlowType &lt;&gt; FlowRange</Expression>
      </Condition>
      <Condition>
        <Name>LSNO</Name>
        <Description>Valve line sized Cv is set for DP specification in Process mode and Cv specification in other modes</Description>
        <Expression>LineSizedCv = Actual or FlowType = FlowRange</Expression>
      </Condition>
      <Condition>
        <Name>LSNFR</Name>
        <Expression>LineSizedCv = Actual and FlowType &lt;&gt; FlowRange</Expression>
      </Condition>
      <Condition>
        <Name>Elev</Name>
        <Expression>Elevations &lt;&gt; Disabled</Expression>
      </Condition>
      <Condition>
        <Name>AutoSS</Name>
        <Expression>Auto and Mode &lt;&gt; Dynamics</Expression>
      </Condition>
      <Condition>
        <Name>AutoDyn</Name>
        <Expression>Auto and Mode = Dynamics</Expression>
      </Condition>
      <Condition>
        <Name>FC</Name>
        <Expression>FailPosition = Closed</Expression>
      </Condition>
      <Condition>
        <Name>FO</Name>
        <Expression>FailPosition = open</Expression>
      </Condition>
      <Condition>
        <Name>FL</Name>
        <Expression>FailPosition = Last</Expression>
      </Condition>
      <Condition>
        <Name>ManSS</Name>
        <Expression>Man and Mode &lt;&gt; Dynamics</Expression>
      </Condition>
      <Condition>
        <Name>ManDyn</Name>
        <Expression>Man and Mode = Dynamics</Expression>
      </Condition>
      <Condition>
        <Name>PhaseOvrrde</Name>
        <Expression>Phases &lt;&gt; Fluid</Expression>
      </Condition>
      <Condition>
        <Name>PhaseOvrrdeNo</Name>
        <Expression>Phases = Fluid</Expression>
      </Condition>
      <Condition>
        <Name>SingleState</Name>
        <Expression>RFState = Single</Expression>
      </Condition>
      <Condition>
        <Name>DoubleState</Name>
        <Expression>RFState = Double</Expression>
      </Condition>
      <Condition>
        <Name>DoubleSComp</Name>
        <Expression>DoubleState and Comp</Expression>
      </Condition>
      <Condition>
        <Name>DoubleSIncomp</Name>
        <Expression>DoubleState and Incomp</Expression>
      </Condition>
      <Condition>
        <Name>SingleSNFR</Name>
        <Expression>NFR and SingleState</Expression>
      </Condition>
      <Condition>
        <Name>DoubleSNFR</Name>
        <Expression>NFR and DoubleState</Expression>
      </Condition>
      <Condition>
        <Name>StdNotNone</Name>
        <Expression>Standard &lt;&gt; None and LSCV</Expression>
      </Condition>
      <Condition>
        <Name>StdNone</Name>
        <Expression>Standard = None and LSCV</Expression>
      </Condition>
      <Condition>
        <Name>StdNPS</Name>
        <Expression>Standard = NPS and LSCV</Expression>
      </Condition>
      <Condition>
        <Name>StdDN</Name>
        <Expression>Standard = DN and LSCV</Expression>
      </Condition>
      <Condition>
        <Name>StdJISA</Name>
        <Expression>Standard = "JIS A" and LSCV</Expression>
      </Condition>
      <Condition>
        <Name>StdJISB</Name>
        <Expression>Standard = "JIS B" and LSCV</Expression>
      </Condition>
      <Condition>
        <Name>StdGOST</Name>
        <Expression>Standard = GOST and LSCV</Expression>
      </Condition>
      <Condition>
        <Name>StdDIN</Name>
        <Expression>Standard = DIN and LSCV</Expression>
      </Condition>
    </Conditions>
    <Connections>
      <Connection>
        <Name>C1</Name>
        <Type>Parameter</Type>
        <From>In.FluidType</From>
        <To>FluidType</To>
      </Connection>
      <Connection>
        <Name>C2</Name>
        <Type>Parameter</Type>
        <From>In.FluidType</From>
        <To>Out.FluidType</To>
      </Connection>
      <Connection>
        <Name>C3</Name>
        <Type>Parameter</Type>
        <From>In.FluidType</From>
        <To>InState.FluidType</To>
      </Connection>
      <Connection>
        <Name>C4</Name>
        <Type>Parameter</Type>
        <From>In.FluidType</From>
        <To>OutState.FluidType</To>
      </Connection>
      <Connection>
        <Name>C5</Name>
        <Type>Parameter</Type>
        <From>Tc</From>
        <To>Actuator.Tc</To>
      </Connection>
      <Connection>
        <Name>C6</Name>
        <Type>Variable</Type>
        <From>In.F</From>
        <To>Out.F</To>
      </Connection>
      <Connection>
        <Name>C12</Name>
        <Condition>SingleSNFR</Condition>
