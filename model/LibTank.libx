  </Model>
  <Model>
    <Type>Source</Type>
    <Description>Feed source conditions</Description>
    <NamePrefix>SRC</NamePrefix>
    <NameStartingNumber>1</NameStartingNumber>
    <Parameters>
      <Parameter>
        <Name>FluidType</Name>
        <Description>Source fluid type.\nTo update FluidType, drag drop a fluid over this source.\nPlace a fluid in your simulation library to modify it.</Description>
        <Type>FluidType</Type>
        <Group>Configuration</Group>
        <Default>Process.DefFluid</Default>
        <Required />
        <Favorite />
      </Parameter>
      <Parameter>
        <Name>CompBasis</Name>
        <Description>Source composition basis for M vector</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Molar</Default>
        <Favorite />
        <Values>
          <Value>Molar</Value>
          <Value>Mass</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Reactions</Name>
        <Description>Source reaction option</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Include</Default>
        <Values>
          <Value>Ignore</Value>
          <Value>Include</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>RxnRateBasis</Name>
        <Description>Global fluid equilibrium reaction rate basis.\n     Absolute: Reaction rates represent absolute molar rates of change. \n     Per Unit Feed: Reaction rates are normalized based on the feed flow \n         rate. Representing the molar change per unit feed, they become\n         independent of the absolute flow rate (preferred).\n\nBoth options yield identical results, but require different formulations\nin the reaction Rate model. “Per Unit Feed” is recommended due to\nbetter numerical stability when stream flows approach zero rate.\nStarting with v2023 fluid reactions are defaulted to the "Per Unit Feed"\noption.  The "Absolute" option is retained for compatibility with\nsimulations built before v2023 and will be removed in a future release.</Description>
        <Type>Enumeration</Type>
        <Group>Reaction Results</Group>
        <Default>Per Unit Feed</Default>
        <Favorite />
        <Global />
        <Values>
          <Value>Absolute</Value>
          <Value>Per Unit Feed</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Industry</Name>
        <Description>Source selection to calculate industry-specific property sets \n   Petro: Standard liquid density, vapor/liquid standard flow</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Hide</Default>
        <Favorite />
        <Values>
          <Value>Hide</Value>
          <Value>Petro</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Flow</Name>
        <Description>Source Reference options for flow.\n    Reference: use the molar flow value from the reference port.\n    Source: specify either W, F, or Q\n Be prepared to remove one pressure specification in the flow line right after switching to Fluid Flow and Dynamics modes, since the flowrate will be determined through the reference.</Description>
        <Type>Enumeration</Type>
        <Group>Reference</Group>
        <Default>Reference</Default>
        <Favorite />
        <Values>
          <Value>Reference</Value>
          <Value>Source</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Pressure</Name>
        <Description>Source Reference options for pressure\n     Reference: use the pressure value from the reference port.\n     Source: specify variable P in this source.</Description>
        <Type>Enumeration</Type>
        <Group>Reference</Group>
        <Default>Reference</Default>
        <Favorite />
        <Values>
          <Value>Reference</Value>
          <Value>Source</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Enthalpy</Name>
        <Description>Source Reference options for enthalpy\n     Reference: use the enthalpy value from the reference port.\n     Source: specify variable T, VF or H in this source.</Description>
        <Type>Enumeration</Type>
        <Group>Reference</Group>
        <Default>Reference</Default>
        <Favorite />
        <Values>
          <Value>Reference</Value>
          <Value>Source</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Composition</Name>
        <Description>Source Reference options for composition\n     Reference: use the molar composition value from the reference port.\n     Source: specify variable M in this source.</Description>
        <Type>Enumeration</Type>
        <Group>Reference</Group>
        <Default>Reference</Default>
        <Favorite />
        <Values>
          <Value>Reference</Value>
          <Value>Source</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>ModeCheck</Name>
        <Description>Global check for mode change warnings while still in process mode</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Process</Default>
        <Favorite />
        <Global />
        <Values>
          <Value>Process</Value>
          <Value>AllModes</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>FRramp</Name>
        <Description>Global flow parameter to ramp from forward stream\nconditions to reverse stream conditions.\n\nFor steady state simulations, use a value smaller than\nthe smallest flowrate in your simulation.\n\nFor dynamic simulations, the FRramp will cause the\nthermodynamic state calculations to use the forward\nenthalpy/composition when the flow is greater than\nFRramp, reverse enthalpy/composition when flow is\nless than negative FRramp, and ramp the values in\nbetween negative FRramp and FRramp as flow reversal\ntakes place.\n\nA larger value will smooth out sudden discontinuities\nfor dynamics but stream properties may appear wrong\nnear zero flow in steady state simulations.</Description>
        <Type>Mole Flow</Type>
        <Group>Configuration</Group>
        <Default>0.001</Default>
        <Favorite />
        <Global />
      </Parameter>
      <Parameter>
        <Name>Elevations</Name>
        <Description>Global selection to enable the specification of equipment port elevations.\n     Disabled: disable specifications for port elevations.  The elevation change (DE) can still be specified in the Pipe and PipeRig models.\n     Manual: manually specify port elevations. DE in the Pipe and PipeRig models can be swapped for port elevation specifications.\n     Automatic: automatically calculate port elevations using equipment geometry and configuration options for select models (Column, Drum, etc).\n\nWhen automatic elevations are enabled, an elevation specification must be removed from each inlet stream of impacted models (for example, remove the DE specification from an inlet Pipe).\nOther model elevations must still be manually specified. For an explanation of how port elevations are estimated, see each model's help file.</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Disabled</Default>
        <Favorite />
        <Global />
        <Values>
          <Value>Disabled</Value>
          <Value>Manual</Value>
          <Value>Automatic</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>Phases</Name>
        <Description>Source option to override the fluid phase selection\n     Fluid: The FluidType's phases are applied.\n     Vapor: The phases are set to Vapor.\n     Liquid: The phases are set to Liquid.\n     VLE: The phases are set to VLE.\n     VLWE: The phases are set to VLWE.\n     VLLE: The phases are set to VLLE.</Description>
        <Type>Enumeration</Type>
        <Group>Configuration</Group>
        <Default>Fluid</Default>
        <Favorite />
        <Values>
          <Value>Fluid</Value>
          <Value>Vapor</Value>
          <Value>Liquid</Value>
          <Value>VLE</Value>
          <Value>VLWE</Value>
          <Value>VLLE</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>PhaseNoOverride</Name>
        <Description>Source PhaseOverride parameter defaulted to NoOverride which is used for the connection to the State.PhaseOverride when Phases = Fluid</Description>
        <Type>Enumeration</Type>
        <Default>NoOverride</Default>
        <Values>
          <Value>NoOverride</Value>
        </Values>
      </Parameter>
      <Parameter>
        <Name>OutFlashCheck</Name>
        <Description>Source compulsory check for out flash temperature</Description>
        <Type>Enumeration</Type>
        <Default>Yes</Default>
        <Values>
          <Value>Yes</Value>
        </Values>
      </Parameter>
    </Parameters>
    <Conditions>
      <Condition>
        <Name>C</Name>
        <Description>Used for debugging</Description>
        <Expression>False</Expression>
      </Condition>
      <Condition>
        <Name>VLE</Name>
        <Expression>(FluidType.Phase = VLE and Phases = Fluid) or (Phases = VLE)</Expression>
      </Condition>
      <Condition>
        <Name>VLLE</Name>
        <Expression>((FluidType.Phase = VLWE or FluidType.Phase = VLLE) and Phases = Fluid) or Phases = VLWE or Phases = VLLE</Expression>
      </Condition>
      <Condition>
        <Name>MPVLE</Name>
        <Description>Multiphase VLE</Description>
        <Expression>FluidType.Class = Compositional and VLE</Expression>
      </Condition>
      <Condition>
        <Name>MPVLLE</Name>
        <Description>Multiphase VLLE</Description>
        <Expression>FluidType.Class = Compositional and VLLE</Expression>
      </Condition>
      <Condition>
        <Name>SP</Name>
        <Description>Single phase</Description>
        <Expression>(not (VLE or VLLE)) or (Phases = Vapor or Phases = Liquid)</Expression>
      </Condition>
      <Condition>
        <Name>CMP</Name>
        <Description>Compositional fluid</Description>
        <Expression>FluidType.Class = Compositional</Expression>
      </Condition>
      <Condition>
        <Name>CMPMol</Name>
        <Description>Compositional fluid with mole basis</Description>
        <Expression>(CompBasis=Molar or (Ref1 and Composition = Reference)) and FluidType.Class = Compositional</Expression>
      </Condition>
      <Condition>
        <Name>LB</Name>
        <Description>Loop back</Description>
        <Expression>Out.NumberOfConnections=0</Expression>
      </Condition>
      <Condition>
        <Name>Mol</Name>
        <Description>Mole component basis</Description>
        <Expression>(CompBasis=Molar and FluidType.Class = Compositional) or (FluidType.Class &lt;&gt; Compositional)</Expression>
      </Condition>
      <Condition>
        <Name>Mas</Name>
        <Description>Mass component basis</Description>
        <Expression>CompBasis=Mass and FluidType.Class = Compositional</Expression>
      </Condition>
      <Condition>
        <Name>MasRef0</Name>
        <Description>Source reference option for composition is set to reference and mass</Description>
        <Expression>Mas and (Ref0 or (Ref1 and Composition = Source))</Expression>
      </Condition>
      <Condition>
        <Name>MC0</Name>
        <Description>Mode check in process mode</Description>
        <Expression>ModeCheck = AllModes and Mode = Process</Expression>
      </Condition>
      <Condition>
        <Name>MC</Name>
        <Description>Mode check in fluid flow and dynamics modes</Description>
        <Expression>ModeCheck=AllModes or MODE&lt;&gt;Process</Expression>
      </Condition>
      <Condition>
        <Name>Rxn</Name>
        <Description>Reactions are present</Description>
        <Expression>FluidType.ReactionModel &lt;&gt; "" and FluidType.ReactionModel &lt;&gt; "Process.DefEQ" and FluidType.ReactionModel &lt;&gt; "Process.DefRate" and FluidType.Class = Compositional and Reactions = Include</Expression>
      </Condition>
      <Condition>
        <Name>RxnRate</Name>
        <Description>Reactions with absolute basis</Description>
        <Expression>Rxn and RxnRateBasis = "Absolute"</Expression>
      </Condition>
      <Condition>
        <Name>RxnRatePF</Name>
        <Description>Reactions with per unit feed basis</Description>
        <Expression>Rxn and RxnRateBasis = "Per Unit Feed"</Expression>
      </Condition>
      <Condition>
        <Name>ProRxnRatePF</Name>
        <Description>Reactions with per unit feed basis in process mode</Description>
        <Expression>Mode = Process and RxnRatePF</Expression>
      </Condition>
      <Condition>
        <Name>Pro_Rxn</Name>
        <Description>Reactions in process mode</Description>
        <Expression>(Mode = Process and ModeCheck = Process) and Rxn</Expression>
      </Condition>
      <Condition>
        <Name>FD_Rxn</Name>
        <Description>Reactions in fluid flow or dynamics modes</Description>
        <Expression>MC and Rxn</Expression>
      </Condition>
      <Condition>
        <Name>NoRxn</Name>
        <Description>No reactions</Description>
        <Expression>not Rxn</Expression>
      </Condition>
      <Condition>
        <Name>FD_CMP</Name>
        <Description>Compositional fluid in fluid flow and dynamics modes</Description>
        <Expression>(MC and NoRxn) and CMP</Expression>
      </Condition>
      <Condition>
        <Name>Pro_nCMP</Name>
        <Description>Not compositional fluids in process mode</Description>
        <Expression>(Mode = Process and ModeCheck = Process and NoRxn and CMP) or FluidType.Class &lt;&gt; Compositional</Expression>
      </Condition>
      <Condition>
        <Name>Petro</Name>
        <Description>Petroleum fluid</Description>
        <Expression>CMP and Industry = Petro</Expression>
      </Condition>
      <Condition>
        <Name>MPMas</Name>
        <Description>Multiphase with mass basis</Description>
        <Expression>CompBasis=Mass and (MPVLE or MPVLLE)</Expression>
      </Condition>
      <Condition>
        <Name>SPMas</Name>
        <Description>Single phase with mass basis</Description>
        <Expression>CompBasis=Mass and SP</Expression>
      </Condition>
      <Condition>
        <Name>Ref1</Name>
        <Description>Reference port is connected</Description>
        <Expression>RefIn.NumberOfConnections &gt; 0</Expression>
      </Condition>
      <Condition>
        <Name>Ref0</Name>
        <Description>Reference port is not connected</Description>
        <Expression>RefIn.NumberOfConnections = 0</Expression>
      </Condition>
      <Condition>
        <Name>FlowSpec</Name>
        <Description>Source reference option for flow is set to source</Description>
        <Expression>Ref0 or Flow = Source</Expression>
      </Condition>
      <Condition>
        <Name>FlowRef</Name>
        <Description>Source reference option for flow is set to reference</Description>
        <Expression>Ref1 and Flow = Reference</Expression>
      </Condition>
      <Condition>
        <Name>PressSpec</Name>
        <Description>Source reference option for pressure is set to source</Description>
        <Expression>Ref0 or Pressure = Source</Expression>
      </Condition>
      <Condition>
        <Name>PressRef</Name>
        <Description>Source reference option for pressure is set to reference</Description>
        <Expression>Ref1 and Pressure = Reference</Expression>
      </Condition>
      <Condition>
        <Name>EnthSpec</Name>
        <Description>Source reference option for enthalpy is set to source</Description>
        <Expression>Ref0 or Enthalpy = Source</Expression>
      </Condition>
      <Condition>
        <Name>EnthRef</Name>
        <Description>Source reference option for enthalpy is set to reference</Description>
        <Expression>Ref1 and Enthalpy = Reference</Expression>
      </Condition>
      <Condition>
        <Name>EnthRefNoRxn</Name>
        <Description>Enthalpy set to reference with no reactions</Description>
        <Expression>EnthRef and NoRxn</Expression>
      </Condition>
      <Condition>
        <Name>EnthRefRxnRatePF</Name>
        <Description>Enthalpy set to reference with per unit feed reaction basis</Description>
        <Expression>EnthRef and Rxn and RxnRateBasis = "Per Unit Feed"</Expression>
      </Condition>
      <Condition>
        <Name>EnthRefRxnRate</Name>
        <Description>Enthalpy set to reference with absolute reaction basis</Description>
        <Expression>EnthRef and Rxn and RxnRateBasis = "Absolute"</Expression>
      </Condition>
      <Condition>
        <Name>MolCompSpec</Name>
        <Description>Source reference option for composition is set to source and mole</Description>
        <Expression>(Ref0 or (Ref1 and Composition = Source)) and Mol</Expression>
      </Condition>
      <Condition>
        <Name>MolCompRef</Name>
        <Description>Source reference option for composition is set to reference and mole</Description>
        <Expression>(Ref1 and Composition = Reference) and Mol</Expression>
      </Condition>
      <Condition>
        <Name>CompSpec</Name>
        <Description>Source reference option for composition is set to source</Description>
        <Expression>Ref0 or Composition = Source</Expression>
      </Condition>
      <Condition>
        <Name>CompRef</Name>
        <Description>Source reference option for composition is set to reference</Description>
        <Expression>Ref1 and Composition = Reference</Expression>
      </Condition>
      <Condition>
        <Name>MasCompSpec</Name>
        <Description>Source reference option for composition is set to source and mass</Description>
        <Expression>(Ref0 or (Ref1 and Composition = Source)) and Mas</Expression>
      </Condition>
      <Condition>
        <Name>MasCompRef</Name>
        <Description>Source reference option for composition is set to reference and mass</Description>
        <Expression>(Ref1 and Composition = Reference) and Mas</Expression>
      </Condition>
      <Condition>
        <Name>Elev</Name>
        <Description>Elevation</Description>
        <Expression>Elevations &lt;&gt; Disabled</Expression>
      </Condition>
      <Condition>
        <Name>PhaseOvrrde</Name>
        <Description>Phase is specified by the user</Description>
        <Expression>Phases &lt;&gt; Fluid</Expression>
      </Condition>
      <Condition>
        <Name>PhaseOvrrdeNo</Name>
        <Description>Phase is specified by the fluid</Description>
        <Expression>Phases = Fluid</Expression>
      </Condition>
      <Condition>
        <Name>EOSorGS</Name>
        <Description>Equation of state</Description>
        <Expression>FluidType.System = SRK or FluidType.System = PR or FluidType.System = SRKM or FluidType.System = PRM or FluidType.System = SRKH or FluidType.System = PSRK or FluidType.System = GS  or FluidType.System = IGS</Expression>
      </Condition>
      <Condition>
        <Name>MPVLLEMas</Name>
        <Description>Multiphase VLLE with mass basis</Description>
        <Expression>MPVLLE and Mas</Expression>
      </Condition>
      <Condition>
        <Name>MPVLLEMol</Name>
        <Description>Multiphase VLLE with mole basis</Description>
        <Expression>MPVLLE and Mol</Expression>
      </Condition>
      <Condition>
        <Name>SS</Name>
        <Expression>Mode &lt;&gt; Dynamics</Expression>
      </Condition>
      <Condition>
        <Name>HasSolids</Name>
        <Expression>FluidType.HasSolids = 1</Expression>
      </Condition>
    </Conditions>
    <Connections>
      <Connection>
        <Name>FT1</Name>
        <Type>Parameter</Type>
        <From>FluidType</From>
        <To>State.FluidType</To>
      </Connection>
      <Connection>
        <Name>FT2</Name>
        <Type>Parameter</Type>
        <From>FluidType</From>
        <To>Out.FluidType</To>
      </Connection>
      <Connection>
        <Name>RefFT1</Name>
        <Condition>Ref1</Condition>
        <Type>Parameter</Type>
        <From>RefIn.FluidType</From>
        <To>FluidType</To>
      </Connection>
      <Connection>
        <Name>NoRxnMBal1</Name>
        <Condition>NoRxn</Condition>
        <Type>Variable</Type>
        <From>F</From>
        <To>Out.F</To>
      </Connection>
      <Connection>
        <Name>P1</Name>
        <Type>Variable</Type>
        <From>P</From>
        <To>Out.P</To>
      </Connection>
      <Connection>
        <Name>P2</Name>
        <Type>Variable</Type>
        <From>P</From>
        <To>State.P</To>
      </Connection>
      <Connection>
        <Name>T1</Name>
        <Type>Variable</Type>
        <From>T</From>
        <To>State.T</To>
      </Connection>
      <Connection>
        <Name>H1</Name>
        <Type>Variable</Type>
        <From>H</From>
        <To>Out.H</To>
      </Connection>
      <Connection>
        <Name>H2</Name>
        <Type>Variable</Type>
        <From>State.H</From>
        <To>Out.H</To>
      </Connection>
      <Connection>
        <Name>NoRxnMW1</Name>
        <Condition>NoRxn</Condition>
        <Type>Variable</Type>
        <From>State.MW</From>
        <To>MW</To>
      </Connection>
      <Connection>
        <Name>VF1</Name>
        <Condition>MPVLE</Condition>
        <Type>Variable</Type>
        <From>VF</From>
        <To>State.VFu</To>
      </Connection>
      <Connection>
        <Name>VF2</Name>
        <Condition>MPVLLE</Condition>
        <Type>Variable</Type>
        <From>VF</From>
        <To>State.VFu</To>
      </Connection>
      <Connection>
        <Name>VF3</Name>
        <Condition>SP</Condition>
        <Type>Variable</Type>
        <From>VF</From>
        <To>State.VF</To>
      </Connection>
      <Connection>
        <Name>Z1</Name>
        <Type>Variable</Type>
        <From>State.z</From>
        <To>Out.z</To>
      </Connection>
      <Connection>
        <Name>NoRxnZ2</Name>
        <Condition>NoRxn</Condition>
        <Type>Variable</Type>
        <From>z</From>
        <To>State.z</To>
      </Connection>
      <Connection>
        <Name>RxnBasis</Name>
        <Condition>Rxn</Condition>
        <Type>Parameter</Type>
        <From>RxnRateBasis</From>
        <To>Reaction.RxnRateBasis</To>
      </Connection>
      <Connection>
        <Name>RxnRte1</Name>
        <Condition>RxnRate</Condition>
        <Type>Variable</Type>
        <From>Reaction.Rate</From>
        <To>Rate</To>
      </Connection>
      <Connection>
        <Name>RxnRtePF_Z2</Name>
        <Condition>RxnRatePF</Condition>
        <Type>Variable</Type>
        <From>Reaction.dz</From>
        <To>dz</To>
      </Connection>
      <Connection>
        <Name>RxnFT</Name>
        <Condition>Rxn</Condition>
        <Type>Parameter</Type>
        <From>FluidType</From>
        <To>Reaction.FluidType</To>
      </Connection>
      <Connection>
        <Name>RxnState</Name>
        <Condition>Rxn</Condition>
        <Type>Model</Type>
        <From>State</From>
        <To>Reaction.StateX</To>
      </Connection>
      <Connection>
        <Name>Rxnx</Name>
        <Condition>Rxn</Condition>
        <Type>Variable</Type>
        <From>State.x</From>
        <To>Reaction.x</To>
      </Connection>
      <Connection>
        <Name>Rxny</Name>
        <Condition>Rxn</Condition>
        <Type>Variable</Type>
        <From>State.y</From>
        <To>Reaction.y</To>
      </Connection>
      <Connection>
        <Name>RxnZ3</Name>
        <Condition>Rxn</Condition>
        <Type>Variable</Type>
        <From>State.z</From>
        <To>Reaction.z</To>
      </Connection>
      <Connection>
        <Name>Rxngamma</Name>
        <Condition>Rxn</Condition>
        <Type>Variable</Type>
        <From>State.gammal</From>
        <To>Reaction.gamma</To>
      </Connection>
      <Connection>
        <Name>Rxnzou</Name>
        <Description>Source outlet flow post reaction</Description>
        <Condition>Rxn</Condition>
        <Type>Variable</Type>
        <From>Fout</From>
        <To>Out.F</To>
      </Connection>
      <Connection>
        <Name>RxnZ4</Name>
        <Description>Source outlet composition post reaction</Description>
        <Condition>Rxn</Condition>
        <Type>Variable</Type>
        <From>zout</From>
        <To>State.z</To>
      </Connection>
      <Connection>
        <Name>RxnT</Name>
        <Condition>Rxn</Condition>
        <Type>Variable</Type>
        <From>State.T</From>
        <To>Reaction.T</To>
      </Connection>
      <Connection>
        <Name>RxnH3</Name>
        <Condition>ProRxnRatePF</Condition>
        <Type>Variable</Type>
        <From>H</From>
        <To>Hout</To>
      </Connection>
      <Connection>
        <Name>RxnRtePF_F1</Name>
        <Condition>ProRxnRatePF</Condition>
        <Type>Variable</Type>
        <From>F</From>
        <To>Fin</To>
      </Connection>
      <Connection>
        <Name>RxnRtePF_Z5</Name>
        <Condition>ProRxnRatePF</Condition>
        <Type>Variable</Type>
        <From>z</From>
        <To>zin</To>
      </Connection>
      <Connection>
        <Name>RxnRtePF_Hm1</Name>
        <Description>In the absence of InState, inlet enthalpy Hin is calculated by equating Hmin to Hmout</Description>
        <Condition>ProRxnRatePF</Condition>
        <Type>Variable</Type>
        <From>Hmin</From>
        <To>Hmout</To>
      </Connection>
      <Connection>
        <Name>ConnEl</Name>
        <Condition>Elev</Condition>
        <Type>Variable</Type>
        <From>El</From>
        <To>Out.El</To>
      </Connection>
      <Connection>
        <Name>PHASEOVR1a</Name>
        <Condition>PhaseOvrrde</Condition>
        <Type>Parameter</Type>
        <From>Phases</From>
        <To>State.PhaseOverride</To>
      </Connection>
      <Connection>
        <Name>PHASEOVR1b</Name>
        <Condition>PhaseOvrrdeNo</Condition>
        <Type>Parameter</Type>
        <From>PhaseNoOverride</From>
        <To>State.PhaseOverride</To>
      </Connection>
      <Connection>
        <Name>Conn1</Name>
        <Condition>MPVLLEMol</Condition>
        <Type>Variable</Type>
        <From>State.L1F</From>
        <To>L1F</To>
      </Connection>
      <Connection>
        <Name>Conn2</Name>
        <Condition>MPVLLEMol</Condition>
        <Type>Variable</Type>
        <From>State.L2F</From>
        <To>L2F</To>
      </Connection>
      <Connection>
        <Name>Tchk1</Name>
        <Type>Variable</Type>
        <From>T</From>
        <To>Out.Tchk</To>
      </Connection>
      <Connection>
        <Name>Tchk2</Name>
        <Type>Parameter</Type>
        <From>OutFlashCheck</From>
        <To>Out.FlashCheck</To>
      </Connection>
    </Connections>
    <Variables>
      <Variable>
        <Name>W</Name>
        <Description>Source forward mass flow</Description>
        <Condition>FlowSpec</Condition>
        <Type>Mass Flow</Type>
        <Group>Operation</Group>
        <ProcessMode />
        <Required />
        <Favorite />
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>W</Name>
        <Description>Source Reference Stream forward mass flow</Description>
        <Condition>FlowRef</Condition>
        <Type>Mass Flow</Type>
        <Group>Operation</Group>
        <Favorite />
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>F</Name>
        <Description>Source molar or gas standard volumetric flow (before reaction)</Description>
        <Type>Mole Flow</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>-1000000</Min>
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>Q</Name>
        <Description>Source forward actual volumetric flow (after reaction)</Description>
        <Type>Vol Flow</Type>
        <Group>Operation</Group>
        <Min>-1000000</Min>
        <Default>0.001</Default>
      </Variable>
      <Variable>
        <Name>P</Name>
        <Description>Source pressure</Description>
        <Condition>PressSpec</Condition>
        <Type>Pressure</Type>
        <Group>Operation</Group>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
        <Required />
        <Favorite />
        <Min>FluidType.PMin</Min>
        <Max>FluidType.PMax</Max>
        <Default>FluidType.Pressure</Default>
      </Variable>
      <Variable>
        <Name>P</Name>
        <Description>Source Reference Stream pressure</Description>
        <Condition>PressRef</Condition>
        <Type>Pressure</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>FluidType.PMin</Min>
        <Max>FluidType.PMax</Max>
        <Default>FluidType.Pressure</Default>
      </Variable>
      <Variable>
        <Name>T</Name>
        <Description>Source equilibrium temperature</Description>
        <Condition>EnthSpec</Condition>
        <Type>Temperature</Type>
        <Group>Operation</Group>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
        <Required />
        <Favorite />
        <Min>FluidType.TMin</Min>
        <Max>FluidType.TMax</Max>
        <Default>FluidType.Temperature</Default>
      </Variable>
      <Variable>
        <Name>T</Name>
        <Description>Source Reference Stream temperature</Description>
        <Condition>EnthRef</Condition>
        <Type>Temperature</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>FluidType.TMin</Min>
        <Max>FluidType.TMax</Max>
        <Default>FluidType.Temperature</Default>
      </Variable>
      <Variable>
        <Name>VF</Name>
        <Description>Source unbounded molar vapor fraction (after reaction).\nVF &lt; 0 is subcooled, VF = 0 is the bubble point, VF = 1 is the dew point, and VF &gt; 1 is superheated</Description>
        <Condition>MPVLE</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Required />
        <Favorite />
        <Max>0</Max>
      </Variable>
      <Variable>
        <Name>VF</Name>
        <Description>Source unbounded molar vapor fraction (after reaction).\nVF &lt; 0 is subcooled, VF = 0 is the bubble point, VF = 1 is the dew point, and VF &gt; 1 is superheated</Description>
        <Condition>MPVLLE</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Favorite />
        <Max>0</Max>
      </Variable>
      <Variable>
        <Name>VF</Name>
        <Description>Source molar vapor fraction (after reaction)</Description>
        <Condition>SP</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Required />
        <Favorite />
      </Variable>
      <Variable>
        <Name>LFm</Name>
        <Description>Source unbounded mass liquid fraction (after reaction).\nLFm&gt;1 is subcooled, LFm=1 bubble-point, LFm=0 dew-point, LFm&lt;0 superheated</Description>
        <Condition>MPMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Required />
        <Favorite />
        <Max>0</Max>
      </Variable>
      <Variable>
        <Name>LFm</Name>
        <Description>Source mass liquid fraction (after reaction)</Description>
        <Condition>SPMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Required />
        <Favorite />
      </Variable>
      <Variable>
        <Name>L1F</Name>
        <Description>Source molar liquid 1 fraction</Description>
        <Condition>MPVLLEMol</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>L2F</Name>
        <Description>Source molar liquid 2 fraction</Description>
        <Condition>MPVLLEMol</Condition>
        <Type>Molar Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>L1Fm</Name>
        <Description>Source mass liquid 1 fraction</Description>
        <Condition>MPVLLEMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>L2Fm</Name>
        <Description>Source mass liquid 2 fraction</Description>
        <Condition>MPVLLEMas</Condition>
        <Type>Mass Composition</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>M</Name>
        <Description>Source unnormalized molar feed composition (before reaction). To specify in fractions, specify all but one and specify Mt=1</Description>
        <Condition>MolCompSpec</Condition>
        <Type>Moles</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Operation</Group>
        <ProcessMode Lock="One">true</ProcessMode>
        <FluidFlowMode Lock="One">true</FluidFlowMode>
        <DynamicMode Lock="One">true</DynamicMode>
        <Required />
        <Favorite />
        <Min>0</Min>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>M</Name>
        <Description>Source Reference Stream composition (before reaction)</Description>
        <Condition>MolCompRef</Condition>
        <Type>Moles</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Operation</Group>
        <Required />
        <Favorite />
        <Min>0</Min>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>Mt</Name>
        <Description>Source total moles for composition normalization</Description>
        <Condition>Mol</Condition>
        <Type>Moles</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>0</Min>
        <Default>0.1</Default>
      </Variable>
      <Variable>
        <Name>M</Name>
        <Description>Source unnormalized mass feed composition (before reaction). To specify in fractions, specify all but one and specify Mt=1</Description>
        <Condition>MasCompSpec</Condition>
        <Type>Mass</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Operation</Group>
        <ProcessMode Lock="One">true</ProcessMode>
        <FluidFlowMode Lock="One">true</FluidFlowMode>
        <DynamicMode Lock="One">true</DynamicMode>
        <Required />
        <Favorite />
        <Min>0</Min>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>M</Name>
        <Description>Source Reference Stream mass composition (before reaction)</Description>
        <Condition>MasCompRef</Condition>
        <Type>Mass</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Operation</Group>
        <Required />
        <Favorite />
        <Min>0</Min>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>Mt</Name>
        <Description>Source total mass for composition normalization</Description>
        <Condition>Mas</Condition>
        <Type>Mass</Type>
        <Group>Operation</Group>
        <Favorite />
        <Min>0.0001</Min>
        <Default>0.1</Default>
      </Variable>
      <Variable>
        <Name>z</Name>
        <Description>Source mole fractions (before reaction). Avoid specifying and instead specify M.</Description>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Operation</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>zm</Name>
        <Description>Source mass fractions (before reaction). Avoid specifying and instead specify M.</Description>
        <Condition>CMP</Condition>
        <Type>Mass Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Operation</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Max>0</Max>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>MW</Name>
        <Description>Source molecular weight (before reaction)</Description>
        <Type>Molar Weight</Type>
        <Group>Operation</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>H</Name>
        <Description>Source molar enthalpy (after reaction)</Description>
        <Type>Molar Enthalpy</Type>
        <Default>1000</Default>
      </Variable>
      <Variable>
        <Name>Rate</Name>
        <Description>Source fluid reaction molar flowrate change for each component</Description>
        <Condition>RxnRate</Condition>
        <Type>Mole Flow</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Reaction Results</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Favorite />
        <Min>-1000000</Min>
        <Default>0</Default>
      </Variable>
      <Variable>
        <Name>dz</Name>
        <Description>Source fluid reaction composition change for each component</Description>
        <Condition>RxnRatePF</Condition>
        <Type>Reaction Rate per Unit Feed</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Reaction Results</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Favorite />
      </Variable>
      <Variable>
        <Name>Fin</Name>
        <Description>Source molar flow before reaction</Description>
        <Condition>ProRxnRatePF</Condition>
        <Type>Mole Flow</Type>
        <Group>Reaction Results</Group>
        <Min>-1000000</Min>
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>zin</Name>
        <Description>Source molar composition before reaction</Description>
        <Condition>ProRxnRatePF</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Reaction Results</Group>
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>Hin</Name>
        <Description>Source molar enthalpy before reaction (internal variable)</Description>
        <Condition>ProRxnRatePF</Condition>
        <Type>Molar Enthalpy</Type>
        <Group>Reaction Results</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Min>-1000000000</Min>
        <Max>1000000000</Max>
        <Default>1000</Default>
      </Variable>
      <Variable>
        <Name>Hmin</Name>
        <Description>Source mass enthalpy before reaction (internal variable)</Description>
        <Condition>ProRxnRatePF</Condition>
        <Type>Mass Enthalpy</Type>
        <Group>Reaction Results</Group>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Min>-1000000000</Min>
        <Max>1000000000</Max>
        <Default>1000</Default>
      </Variable>
      <Variable>
        <Name>Fout</Name>
        <Description>Source molar flow after reaction</Description>
        <Condition>Rxn</Condition>
        <Type>Mole Flow</Type>
        <Group>Reaction Results</Group>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Favorite />
        <Min>-1000000</Min>
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>zout</Name>
        <Description>Source molar composition after reaction</Description>
        <Condition>Rxn</Condition>
        <Type>Molar Composition</Type>
        <Dimension>FluidType.CompList</Dimension>
        <Group>Reaction Results</Group>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Favorite />
        <Default>FluidType.Composition</Default>
      </Variable>
      <Variable>
        <Name>Hout</Name>
        <Description>Source molar enthalpy after reaction</Description>
        <Condition>ProRxnRatePF</Condition>
        <Type>Molar Enthalpy</Type>
        <Group>Reaction Results</Group>
        <Min>-1000000000</Min>
        <Max>1000000000</Max>
      </Variable>
      <Variable>
        <Name>Hmout</Name>
        <Description>Source mass enthalpy after reaction</Description>
        <Condition>ProRxnRatePF</Condition>
        <Type>Mass Enthalpy</Type>
        <Group>Reaction Results</Group>
        <Min>-1000000000</Min>
        <Max>1000000000</Max>
      </Variable>
      <Variable>
        <Name>L</Name>
        <Description>Source standard liquid volumetric flow (60 F and 1 atm)</Description>
        <Condition>Petro</Condition>
        <Type>Std Liquid Vol Flow</Type>
        <Group>Petroleum Industry</Group>
        <Favorite />
        <Min>-1000000</Min>
      </Variable>
      <Variable>
        <Name>Gravity</Name>
        <Description>Source specific gravity, API gravity, or liquid density at standard conditions (60 F and 1 atm)</Description>
        <Condition>Petro</Condition>
        <Type>Standard Liquid Density</Type>
        <Group>Petroleum Industry</Group>
        <Favorite />
      </Variable>
      <Variable>
        <Name>MinSG60F</Name>
        <Description>Source minimum SG @ 60F to check for missing standard specific gravity</Description>
        <Condition>Petro</Condition>
        <Type>Specific Gravity</Type>
        <Group>Petroleum Industry</Group>
        <Min>0</Min>
      </Variable>
      <Variable>
        <Name>El</Name>
        <Description>Source elevation</Description>
        <Condition>Elev</Condition>
        <Type>Elevation</Type>
        <Group>Elevation</Group>
        <ProcessMode />
        <FluidFlowMode />
        <DynamicMode />
        <Favorite />
        <Min>-1000</Min>
        <Max>1000</Max>
      </Variable>
      <Variable>
        <Name>Feps</Name>
        <Description>Source small sweep flow safeguard to issue a warning if the flow is smaller than FRramp</Description>
        <Condition>SS</Condition>
        <Type>Mole Flow</Type>
        <Max>0</Max>
      </Variable>
      <Variable>
        <Name>sumy</Name>
        <Description>Source sum of vapor composition to identify where there is a vapor liquid equilibrium</Description>
        <Condition>HasSolids</Condition>
        <Type>Molar Composition</Type>
        <ProcessMode Lock="Always">false</ProcessMode>
        <FluidFlowMode Lock="Always">false</FluidFlowMode>
        <DynamicMode Lock="Always">false</DynamicMode>
        <Max>0</Max>
        <Default>1</Default>
      </Variable>
      <Variable>
        <Name>LF</Name>
        <Description>Source molar liquid fraction</Description>
        <Type>Molar Composition</Type>
      </Variable>
    </Variables>
    <Equations>
      <Equation>
        <Name>NoRxnMBal2</Name>
        <Description>Source mass flow</Description>
        <Condition>Pro_nCMP</Condition>
        <Formula>W = F * State.MW</Formula>
      </Equation>
      <Equation>
        <Name>RxnMBal3</Name>
        <Description>Source post reaction mass flow</Description>
        <Condition>Pro_Rxn</Condition>
        <Formula>W = Fout * State.MW</Formula>
      </Equation>
      <Equation>
        <Name>NoRxnMBal4</Name>
        <Description>Source mass flow</Description>
        <Condition>FD_CMP</Condition>
        <Formula>W = F * select(F, State.MW, sum(Out.zr * FluidType.MW))</Formula>
      </Equation>
      <Equation>
        <Name>RxnMBal5</Name>
        <Description>Source post reaction mass flow</Description>
        <Condition>FD_Rxn</Condition>
        <Formula>W = select(F, Fout * State.MW, F * sum(Out.zr * FluidType.MW))</Formula>
      </Equation>
      <Equation>
        <Name>RxnRteMBal6</Name>
        <Description>Source post reaction flowrate</Description>
        <Condition>RxnRate</Condition>
        <Formula>Fout = F + sum(Rate)</Formula>
      </Equation>
      <Equation>
        <Name>RxnRtePF_MBal7</Name>
        <Description>Source post reaction flowrate</Description>
        <Condition>RxnRatePF</Condition>
        <Formula>Fout = F * (1 + sum(dz))</Formula>
      </Equation>
      <Equation>
        <Name>Q1</Name>
        <Description>Source actual volumetric flow (forward flow)</Description>
        <Formula>Q = F * State.V</Formula>
      </Equation>
      <Equation>
        <Name>Z6</Name>
        <Description>Source mass feed composition</Description>
        <Condition>Mas</Condition>
        <Formula>zm * Mt = M</Formula>
      </Equation>
      <Equation>
        <Name>Z7</Name>
        <Description>Source mole feed composition</Description>
        <Condition>Mol</Condition>
        <Formula>z * Mt = M</Formula>
      </Equation>
      <Equation>
        <Name>Z8</Name>
        <Description>Source mole to mass fraction conversion</Description>
        <Condition>CMPMol</Condition>
        <Formula>zm * sum(z * FluidType.MW) = z * FluidType.MW</Formula>
      </Equation>
      <Equation>
        <Name>Z9</Name>
        <Description>Source mass to mole fraction conversion</Description>
        <Condition>MasRef0</Condition>
        <Formula>z * sum(zm / FluidType.MW) = zm / FluidType.MW </Formula>
      </Equation>
      <Equation>
        <Name>Z10</Name>
        <Description>Source sum of all moles / mass</Description>
        <Condition>CompSpec</Condition>
        <Formula>Mt = sum(M)</Formula>
      </Equation>
      <Equation>
        <Name>Z11</Name>
        <Description>Source sum of all moles / mass with a reference inlet stream</Description>
        <Condition>CompRef</Condition>
        <Formula>Mt = 1</Formula>
      </Equation>
      <Equation>
        <Name>RxnRtePF_CBal1</Name>
        <Description>Source post reaction molar composition</Description>
        <Condition>RxnRatePF</Condition>
        <Formula>z + dz = State.z * (1 + sum(dz))</Formula>
      </Equation>
      <Equation>
        <Name>RxnRteCBal2</Name>
        <Description>Source post reaction molar composition</Description>
        <Condition>RxnRate</Condition>
        <Formula>F * z + Rate = Fout * State.z</Formula>
      </Equation>
      <Equation>
        <Name>RxnMW2</Name>
        <Description>Source post reaction molecular weight</Description>
        <Condition>Rxn</Condition>
        <Formula>MW = sum(z * FluidType.MW)</Formula>
      </Equation>
      <Equation>
        <Name>RxnRtePF_Hm2</Name>
        <Description>Source mass enthalpy before the reaction</Description>
        <Condition>ProRxnRatePF</Condition>
        <Formula>Hmin * sum(zin * FluidType.MW) = Hin</Formula>
      </Equation>
      <Equation>
        <Name>RxnRtePF_Hm3</Name>
        <Description>Source mass enthalpy after the reaction</Description>
        <Condition>ProRxnRatePF</Condition>
        <Formula>Hmout * sum(zout * FluidType.MW) = Hout</Formula>
      </Equation>
      <Equation>
        <Name>StdL1</Name>
        <Description>Source standard liquid volumetric flow (60 F and 1 atm)</Description>
        <Condition>Petro</Condition>
        <Formula>Gravity * L = W</Formula>
      </Equation>
      <Equation>
        <Name>SG601</Name>
        <Description>Source specific gravity, API gravity, or liquid density at standard conditions (60 F and 1 atm)</Description>
        <Condition>Petro</Condition>
        <Formula>999.016 = Gravity * sum(zm / max(FluidType.SG60F, 1E-9))</Formula>
      </Equation>
      <Equation>
        <Name>SG602</Name>
        <Description>Source minimum SG @60F to check for missing standard specific gravity</Description>
        <Condition>Petro</Condition>
        <Formula>minSG60F = min(FluidType.SG60F)</Formula>
      </Equation>
      <Equation>
        <Name>LF1</Name>
        <Description>Source liquid mass fraction</Description>
        <Condition>MPMas</Condition>
        <Formula>LFm * State.MW = (1 - State.VFu) * State.MWl</Formula>
      </Equation>
      <Equation>
        <Name>LF2</Name>
        <Description>Source liquid mass fraction</Description>
        <Condition>SPMas</Condition>
        <Formula>LFm = 1 - State.VF </Formula>
      </Equation>
      <Equation>
        <Name>RefInz</Name>
        <Description>Reference stream composition</Description>
        <Condition>CompRef</Condition>
        <Formula>z = Refin.z</Formula>
      </Equation>
      <Equation>
        <Name>RefInP</Name>
        <Description>Reference stream pressure</Description>
        <Condition>PressRef</Condition>
        <Formula>P = RefIn.P</Formula>
      </Equation>
      <Equation>
        <Name>RefInF</Name>
        <Description>Reference stream mole flow</Description>
        <Condition>FlowRef</Condition>
        <Formula>F = RefIn.F</Formula>
      </Equation>
      <Equation>
        <Name>RefIn_NoRxn_HBal1</Name>
        <Description>Reference stream molar enthalpy</Description>
        <Condition>EnthRefNoRxn</Condition>
        <Formula>H = RefIn.H</Formula>
      </Equation>
      <Equation>
        <Name>RefIn_RtePF_HBal2</Name>
        <Description>Reference stream enthalpy balance</Description>
        <Condition>EnthRefRxnRatePF</Condition>
        <Formula>RefIn.H = Out.H * (1 + sum(dz))</Formula>
      </Equation>
      <Equation>
        <Name>RefIn_RtePF_HBal3</Name>
        <Condition>EnthRefRxnRate</Condition>
        <Formula>RefIn.H = Out.H * (1 + sum(Rate) / sum(F, 1e-6))</Formula>
      </Equation>
      <Equation>
        <Name>LB1</Name>
        <Description>Source loop back reverse enthalpy</Description>
        <Condition>LB</Condition>
        <Formula>Out.Hr = tear(Out.H)</Formula>
      </Equation>
      <Equation>
        <Name>LB2</Name>
        <Description>Source loop back reverse composition</Description>
        <Condition>LB</Condition>
        <Formula>Out.zr = tear(Out.z)</Formula>
      </Equation>
      <Equation>
        <Name>MC_1</Name>
        <Description>Source set pressure device flag for mode check calculations</Description>
        <Condition>FlowSpec</Condition>
        <Formula>Out.setp = 1</Formula>
      </Equation>
      <Equation>
        <Name>MC_2</Name>
        <Description>Source set pressure device flag for mode check calculations </Description>
        <Condition>FlowRef</Condition>
        <Formula>Out.setp = 0</Formula>
      </Equation>
      <Equation>
        <Name>LF3</Name>
        <Description>Source mass liquid 1 fraction</Description>
        <Condition>MPVLLEMas</Condition>
        <Formula>L1Fm * State.MW = State.L1F * State.MWl1</Formula>
      </Equation>
      <Equation>
        <Name>LF4</Name>
        <Description>Source mass liquid 2 fraction</Description>
        <Condition>MPVLLEMas</Condition>
        <Formula>L2Fm * State.MW = State.L2F * State.MWl2</Formula>
      </Equation>
      <Equation>
        <Name>Feps1</Name>
        <Condition>SS</Condition>
        <Formula>Feps = FRramp</Formula>
      </Equation>
      <Equation>
        <Name>EqnSumY</Name>
        <Condition>HasSolids</Condition>
        <Formula>sumy = sum(State.y)</Formula>
      </Equation>
      <Equation>
        <Name>LF5</Name>
        <Formula>LF + State.VF = 1</Formula>
      </Equation>
    </Equations>
    <Models>
      <Model>
        <Name>State</Name>
        <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
      </Model>
      <Model>
        <Name>Reaction</Name>
        <Condition>Rxn</Condition>
        <ModelTypeParameter>FluidType.ReactionModel</ModelTypeParameter>
      </Model>
    </Models>
    <Ports>
      <Port>
        <Name>Out</Name>
        <Direction>Out</Direction>
        <Library Version="8.2.0">Submodels</Library>
        <Type>FlowPort</Type>
      </Port>
      <Port>
        <Name>RefIn</Name>
        <Library Version="8.2.0">Submodels</Library>
        <Type>RefPort</Type>
      </Port>
    </Ports>
    <Groups>
      <Group>
        <Name>Configuration</Name>
        <IsExpandedByDefault>true</IsExpandedByDefault>
      </Group>
      <Group>
        <Name>Operation</Name>
        <IsExpandedByDefault>true</IsExpandedByDefault>
      </Group>
      <Group>
        <Name>Reaction Results</Name>
      </Group>
      <Group>
        <Name>Petroleum Industry</Name>
        <IsExpandedByDefault>true</IsExpandedByDefault>
      </Group>
      <Group>
        <Name>Elevation</Name>
        <Description>Elevation variables for hydraulic calculations. To view and edit elevations, set Elevations = Manual or Automatic.</Description>
      </Group>
      <Group>
        <Name>Reference</Name>
        <Description>Reference options</Description>
      </Group>
    </Groups>
    <Messages>
      <Message>
        <Name>ModeCheck1</Name>
        <Condition>MC</Condition>
        <Expression>Out.NumberOfConnections=0</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Source outlet must be connected for Fluid Flow and Dynamics modes.</DisplayMessage>
      </Message>
      <Message>
        <Name>RxnCheck1</Name>
        <Expression>FluidType.ReactionModel &lt;&gt; "" and FluidType.ReactionModel &lt;&gt; "Process.DefEQ" and FluidType.ReactionModel &lt;&gt; "Process.DefRate" and Reactions = Ignore</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>The reaction model in the fluid is currently being ignored. Change the Reactions parameter to "Include" to enable reaction effects.</DisplayMessage>
      </Message>
      <Message>
        <Name>PetroPropertyWarning</Name>
        <Condition>Petro</Condition>
        <Expression>minSG60F = 0</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Petro property calculations may not be accurate. SG60F data is missing or equals zero for at least one component. Confirm that values are correct in the Thermo Data Manager program.</DisplayMessage>
      </Message>
      <Message>
        <Name>ModeCheckElev</Name>
        <Condition>MC0</Condition>
        <Expression>Elevations = Automatic</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Before switching from Process to Fluid Flow mode, set Elevations = Manual. Automatically calculated elevations will be retained but will not be re-calculated during the mode transition. This allows for hydraulic circuit rating based on the specified design conditions.</DisplayMessage>
      </Message>
      <Message>
        <Name>ModeCheckReference</Name>
        <Condition>MC0</Condition>
        <Expression>FlowRef</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Be prepared to remove one pressure specification in the flow line right after switching to Fluid Flow and Dynamics modes, since the flowrate will be determined through the reference.</DisplayMessage>
      </Message>
      <Message>
        <Name>FluidReactionsUseRate</Name>
        <Condition>Rxn</Condition>
        <Expression>RxnRateBasis = Absolute</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>RxnRateBasis is set to Absolute which will be\nremoved in future releases. Starting with v2023 fluid reactions must\nuse the RxnRateBasis with "Per Unit Feed" value which need a similar\nimplementation in reaction submodel. Please refer to the DefEQ model\nhelp or the thermodynamics reference guide for further information.\n\nPlease set RxnRateBasis = "Per Unit Feed".</DisplayMessage>
      </Message>
      <Message>
        <Name>VLWEforEOSorGSonly</Name>
        <Expression>not EOSorGS and Phases = VLWE</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Phases = VLWE is only recommended for fluids that use any of the following methods: SRK, PR, SRKM, PRM, SRKH, PSRK, GS, IGS. Please review the selection for Phases.</DisplayMessage>
      </Message>
      <Message>
        <Name>LowFlow</Name>
        <Condition>SS</Condition>
        <Expression>Feps &gt; F</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Flow is very low. Downstream calculations may include reverse flow contributions. Confirm that the global FRramp value is less than the smallest downstream molar flow rate.</DisplayMessage>
      </Message>
      <Message>
        <Name>NoVLEquilibrium</Name>
        <Condition>HasSolids</Condition>
        <Expression>sumy &lt; 1e-16</Expression>
        <Severity>Warning</Severity>
        <DisplayMessage>Pure solid stream detected. Please consider adding trace amounts of a non-solid component to avoid numerical problems.</DisplayMessage>
      </Message>
    </Messages>
    <GraphicData>
      <Icon>
        <DefaultIcon>Default</DefaultIcon>
        <Images>
          <Image>
            <Name>Default</Name>
            <Rendering>
              <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
                &lt;Canvas Width="100.000" Height="100.000"&gt;
